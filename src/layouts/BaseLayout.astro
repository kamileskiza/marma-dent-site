---
import { LOCALES, DEFAULT_LOCALE, localePath } from '../i18n/locales';

export interface Props {
  locale: string;
  title: string;
  description: string;
  path: string; // path within the current locale, e.g. '' for home, 'treatment-slug/' for a treatment
  ogImage?: string;
  availableLocales?: string[]; // which locales actually have this page; defaults to all (used for the homepage)
  slugMap?: Record<string, string>; // locale -> that locale's own path for this same piece of content.
    // Required whenever `path` is not identical across locales (e.g. localized treatment slugs).
    // Without it, we only self-reference the current locale rather than guess another locale's slug —
    // guessing would produce hreflang links to URLs that don't exist.
}

const { locale, title, description, path, ogImage = '/images/hollywood-smile.jpg', availableLocales, slugMap } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.dtnizamabdullayev.com';
const canonical = `${site}${localePath(locale, path)}`;
const localeInfo = LOCALES.find((l) => l.code === locale) ?? LOCALES[0];
const hreflangLocales = LOCALES.filter((l) => {
  if (availableLocales && !availableLocales.includes(l.code)) return false;
  // If a slugMap was supplied, only emit a link for locales it actually covers —
  // otherwise we'd fabricate a link from the current locale's path.
  if (slugMap && !(l.code in slugMap) && l.code !== locale) return false;
  return true;
});
function hreflangHref(code: string): string {
  let p: string;
  if (slugMap) {
    p = code in slugMap ? slugMap[code] : (code === locale ? path : '');
  } else {
    p = (availableLocales && !availableLocales.includes(code)) ? '' : path;
  }
  return `${site}${localePath(code, p)}`;
}
---
<!DOCTYPE html>
<html lang={locale} dir={localeInfo.dir}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{hreflangLocales.map((l) => (
  <link rel="alternate" hreflang={l.hreflang} href={hreflangHref(l.code)} />
))}
<link rel="alternate" hreflang="x-default" href={hreflangHref(DEFAULT_LOCALE)} />
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={`${site}${ogImage}`}>
<meta property="og:url" content={canonical}>
<meta property="og:locale" content={locale}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={`${site}${ogImage}`}>
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Dentist",
  "@id": `${site}/#clinic`,
  "name": "Nizam Abdullayev Dental Clinic",
  "url": site,
  "logo": `${site}/images/logo.png`,
  "image": `${site}/images/doctor.jpg`,
  "telephone": "+905551901034",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Bağlarbaşı, Atatürk Caddesi, Galip Arcan Sokağı 1a",
    "addressLocality": "Maltepe",
    "addressRegion": "Istanbul",
    "postalCode": "34844",
    "addressCountry": "TR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 40.929249,
    "longitude": 29.134529
  },
  "areaServed": [{"@type":"City","name":"Istanbul"},{"@type":"Country","name":"Turkey"}],
  "knowsLanguage": LOCALES.map((l) => l.code),
  "sameAs": ["https://www.instagram.com/dtnizamabdullayev"]
})} />
<link rel="icon" type="image/png" href="/images/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Manrope:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
{localeInfo.dir === 'rtl' && (
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
)}
<style is:global>
  :root{
    --bg:#F5F8FA; --bg-alt:#EAF1F5; --ink:#0B2545; --ink-soft:#3F5872; --ink-faint:#5A7290;
    --gold:#1FB9CE; --gold-light:#9FE3EC; --teal:#1FB9CE; --rose:#D9A79A; --white:#FFFFFF;
    --line:rgba(11,37,69,0.12); --shadow:0 20px 50px -25px rgba(11,37,69,0.35);
    --radius:20px; --wa:#2FA96A; --maxw:1180px; --navy:#0B2545; --navy-deep:#081b34;
  }
  *{box-sizing:border-box;} html{scroll-behavior:smooth;scroll-padding-top:112px;}
  @media (max-width:640px){ html{scroll-padding-top:150px;} }
  body{margin:0;background:var(--bg);color:var(--ink);font-family:'Manrope',sans-serif;font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased;}
  h1,h2,h3{font-family:'Fraunces',serif;font-weight:600;line-height:1.08;margin:0 0 .5em;letter-spacing:-0.01em;}
  p{margin:0 0 1em;color:var(--ink-soft);}
  a{color:inherit;} img{display:block;max-width:100%;}
  .mono{font-family:'DM Mono',monospace;}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 28px;}
  .eyebrow{display:inline-flex;align-items:center;gap:8px;font-family:'DM Mono',monospace;font-size:12px;letter-spacing:.05em;text-transform:uppercase;color:var(--gold);background:rgba(198,150,58,0.1);border:1px solid rgba(198,150,58,0.28);padding:7px 14px;border-radius:99px;}
  .eyebrow::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--gold);flex:none;}
  :focus-visible{outline:2.5px solid var(--gold);outline-offset:3px;border-radius:4px;}
  @media (prefers-reduced-motion:reduce){*{animation:none !important;transition:none !important;scroll-behavior:auto !important;}}

  .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:15px 26px;border-radius:99px;font-family:'Manrope',sans-serif;font-weight:700;font-size:15px;text-decoration:none;border:1.5px solid transparent;cursor:pointer;transition:transform .15s ease, box-shadow .15s ease;}
  .btn:hover{transform:translateY(-2px);}
  .btn-gold{background:var(--gold);color:var(--white);box-shadow:0 12px 26px -12px rgba(198,150,58,.65);}
  .btn-outline{background:transparent;border-color:var(--ink);color:var(--ink);}
  .btn-outline:hover{background:var(--ink);color:var(--bg);}
  .btn-wa{background:var(--wa);color:#fff;box-shadow:0 12px 26px -12px rgba(47,169,106,.6);}
  .btn-wa svg{width:18px;height:18px;}
  .btn-block{width:100%;}

  .nav-address{display:flex;align-items:center;gap:7px;font-size:13px;color:var(--ink-soft);}
  .nav-address svg{width:15px;height:15px;color:var(--gold);flex:none;}
  .nav-address a{color:var(--ink-soft);text-decoration:none;}
  .nav-address a:hover{color:var(--gold);text-decoration:underline;}

  .feature-banner{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;}
  .fcard{background:transparent;border-radius:20px;overflow:hidden;border:1px solid rgba(255,255,255,.14);}
  .fcard-photo{width:100%;height:190px;background:rgba(255,255,255,.04);display:flex;align-items:center;justify-content:center;}
  .fcard-photo img{display:block;width:100%;height:100%;object-fit:contain;}
  .fcard-body{padding:16px 18px 20px;}
  .fb-icon{width:32px;height:32px;border-radius:9px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.16);display:flex;align-items:center;justify-content:center;margin-bottom:10px;}

  .digital-static{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;}
  .digital-static-photo{background:var(--bg-alt);border-radius:20px;border:1px solid var(--line);padding:20px;display:flex;align-items:center;justify-content:center;}
  .digital-static-photo img{width:100%;height:auto;max-height:320px;object-fit:contain;}
  .fb-icon--static{width:42px;height:42px;border-radius:11px;background:var(--bg-alt);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;margin-bottom:14px;color:var(--gold);}
  .fb-icon svg{width:17px;height:17px;color:var(--gold-light);}
  .fcard h3{color:#fff;font-size:16px;margin-bottom:4px;font-family:'Manrope',sans-serif;font-weight:700;}
  .fcard p{color:rgba(255,255,255,.75);font-size:12.5px;line-height:1.4;margin:0;}

  .warranty-tag{display:inline-flex;align-items:center;gap:5px;font-family:'DM Mono',monospace;font-size:10.5px;text-transform:uppercase;color:var(--gold);background:rgba(198,150,58,0.12);border:1px solid rgba(198,150,58,0.3);padding:4px 9px;border-radius:99px;margin-top:10px;}
  .warranty-tag svg{width:11px;height:11px;}

  .special-care{text-align:center;margin-top:28px;padding:18px 24px;border:1px dashed var(--line);border-radius:14px;font-size:13.5px;color:var(--ink-soft);}
  .ba-gallery-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:900px;margin:0 auto;}
  .ba-gallery-grid img{width:100%;border-radius:16px;box-shadow:var(--shadow);}
  @media (max-width:640px){ .ba-gallery-grid{grid-template-columns:1fr;} }

  .team-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
  .team-card{background:var(--white);border:1px solid var(--line);border-radius:16px;padding:22px;text-align:center;}
  .team-portrait{max-width:340px;margin:0 auto;border-radius:20px;overflow:hidden;box-shadow:var(--shadow);border:1px solid var(--line);background:var(--white);}
  .team-portrait img{width:100%;height:auto;display:block;}
  .team-portrait-info{padding:20px;text-align:center;}
  .team-portrait-info h3{font-family:'Fraunces',serif;font-size:19px;font-weight:600;margin-bottom:4px;}
  .team-portrait-info span{font-size:13px;color:var(--ink-faint);font-family:'DM Mono',monospace;text-transform:uppercase;letter-spacing:.06em;}
  .team-card img{width:76px;height:76px;border-radius:50%;object-fit:cover;margin:0 auto 12px;}
  .team-card h3{font-size:15.5px;margin-bottom:2px;}
  .team-card span{font-size:12px;color:var(--ink-faint);font-family:'DM Mono',monospace;}
  .team-card--add{border:1.5px dashed var(--line);display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--ink-faint);}
  .team-card--add svg{width:26px;height:26px;margin-bottom:10px;color:var(--ink-faint);}
  .team-card--add p{margin:0;font-size:12.5px;}

  .reviews-layout{display:grid;grid-template-columns:1fr 1.2fr;gap:48px;align-items:start;}
  .review-platforms{display:flex;gap:20px;align-items:center;margin:20px 0;}
  .platform-badge{display:flex;align-items:center;gap:7px;font-weight:700;font-size:15px;color:var(--ink);}
  .platform-badge svg{width:20px;height:20px;}
  .review-score{font-family:'Fraunces',serif;font-weight:700;font-size:44px;color:var(--gold);line-height:1;}
  .count-num{color:#2F6FED;font-weight:800;text-shadow:0 4px 18px rgba(47,111,237,.4);display:inline-block;transition:transform .15s ease;}
  .review-score .count-num{font-size:52px;}
  .review-count .count-num{font-size:22px;}
  .count-num.pop{transform:scale(1.18);}
  .review-score span{font-size:22px;color:var(--ink-faint);}
  .review-score-label{font-weight:700;font-size:15px;margin:6px 0 4px;}
  .review-count{color:var(--ink-faint);font-size:13.5px;margin:0 0 18px;}
  .review-note-card{background:var(--white);border:1.5px dashed var(--line);border-radius:16px;padding:32px;display:flex;flex-direction:column;align-items:flex-start;gap:14px;}
  .review-note-card svg{width:28px;height:28px;color:var(--gold);}
  .review-note-card p{margin:0;font-size:14.5px;}

  .btn-call{background:var(--white);border-color:var(--ink);color:var(--ink);}
  .btn-call:hover{background:var(--ink);color:var(--bg);}
  .btn-call svg{width:17px;height:17px;}

  .accordion{border-top:1px solid var(--line);max-width:760px;margin:0 auto;}
  .acc-item{border-bottom:1px solid var(--line);}
  .acc-trigger{width:100%;display:flex;align-items:center;gap:14px;padding:18px 4px;background:none;border:none;cursor:pointer;text-align:left;font-family:'Manrope',sans-serif;}
  .acc-icon{width:38px;height:38px;border-radius:11px;background:var(--bg-alt);display:flex;align-items:center;justify-content:center;flex:none;}
  .acc-icon svg{width:18px;height:18px;color:var(--gold);}
  .acc-title{flex:1;font-weight:700;font-size:15.5px;color:var(--ink);}
  .acc-chevron{width:16px;height:16px;color:var(--ink-faint);transition:transform .2s ease;flex:none;}
  .acc-item.open .acc-chevron{transform:rotate(180deg);}
  .acc-panel{max-height:0;overflow:hidden;transition:max-height .25s ease;}
  .acc-item.open .acc-panel{max-height:220px;}
  .acc-panel p{padding:0 4px 18px 52px;font-size:13.5px;margin:0;color:var(--ink-soft);}

  header{position:sticky;top:0;z-index:40;background:#FFFFFF;border-bottom:1px solid var(--line);}
  .nav{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 28px;flex-wrap:wrap;}
  .nav-links{display:flex;gap:8px;padding:0 24px 12px;border-top:1px solid var(--line);padding-top:10px;}
  .nav-links a{position:relative;font-size:13px;font-weight:600;color:var(--ink-soft);text-decoration:none;letter-spacing:.01em;padding:6px 10px;border-radius:8px;transition:color .15s ease, background .15s ease;}
  .nav-links a::after{content:"";position:absolute;left:10px;right:10px;bottom:2px;height:2px;background:var(--gold);transform:scaleX(0);transform-origin:left;transition:transform .2s ease;}
  .nav-links a:hover{color:var(--ink);background:var(--bg-alt);}
  .nav-links a:hover::after{transform:scaleX(1);}
  .brand{display:flex;align-items:center;gap:10px;text-decoration:none;}
  .brand img{width:58px;height:auto;}
  .brand-text{display:flex;flex-direction:column;line-height:1.1;}
  .brand-text b{font-family:'Fraunces',serif;font-weight:600;font-size:15.5px;letter-spacing:.005em;line-height:1.15;max-width:190px;}
  .brand-text span{font-family:'DM Mono',monospace;font-size:9.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-soft);margin-top:1px;}
  .nav-right{display:flex;align-items:center;gap:14px;}
  .lang-switch{position:relative;}
  .lang-quick-tr{width:34px;height:34px;border-radius:50%;border:1px solid var(--line);background:var(--white);font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;}
  .lang-quick-tr:hover{border-color:var(--gold);}
  .lang-more-badge{font-size:9.5px;font-weight:800;background:var(--gold);color:#fff;padding:2px 5px;border-radius:99px;line-height:1;letter-spacing:.02em;}
  .lang-trigger{display:flex;align-items:center;gap:7px;background:var(--bg-alt);border:1px solid var(--line);border-radius:99px;padding:8px 12px;cursor:pointer;font-family:'DM Mono',monospace;font-size:11.5px;color:var(--ink);}
  .lang-trigger .flag{font-size:16px;line-height:1;}
  .lang-trigger svg{width:10px;height:10px;color:var(--ink-soft);transition:transform .15s ease;}
  .lang-trigger.open svg{transform:rotate(180deg);}
  .lang-menu{position:absolute;top:calc(100% + 8px);right:0;background:var(--white);border:1px solid var(--line);border-radius:14px;min-width:170px;max-height:260px;overflow-y:auto;display:none;z-index:60;box-shadow:var(--shadow);padding:6px;}
  .lang-menu.open{display:block;}
  .lang-menu button{display:flex;align-items:center;gap:10px;width:100%;text-align:left;padding:9px 10px;border:none;background:transparent;font-family:'Manrope',sans-serif;font-size:13.5px;cursor:pointer;border-radius:9px;color:var(--ink);}
  .lang-menu button:hover{background:var(--bg-alt);}
  .lang-menu button.active{background:rgba(198,150,58,0.14);font-weight:700;}
  .lang-menu .flag{font-size:16px;}

  .hero{padding:52px 0 40px;position:relative;overflow:hidden;}
  .hero-watermark{position:absolute;top:-30px;right:-20px;width:240px;opacity:.1;pointer-events:none;z-index:0;}
  .hero-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:56px;align-items:center;position:relative;z-index:1;}
  .hero h1{font-size:clamp(32px,4.4vw,54px);margin-top:16px;}
  .hero h1 em{font-style:italic;color:var(--gold);}
  .hero p.lead{font-size:17.5px;max-width:48ch;margin-bottom:26px;}
  .cta-row{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:32px;}
  .stat-row{display:flex;gap:26px;flex-wrap:wrap;}
  .stat{display:flex;flex-direction:column;max-width:170px;}
  .stat b{font-family:'DM Mono',monospace;font-size:19px;color:var(--ink);}
  .stat span{font-size:12px;color:var(--ink-faint);}

  .hero-photo{position:relative;min-height:520px;display:flex;align-items:center;overflow:hidden;}
  .hero-photo-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .hero-photo-overlay{position:absolute;inset:0;background:linear-gradient(100deg, rgba(8,27,52,.94) 0%, rgba(8,27,52,.72) 48%, rgba(8,27,52,.32) 100%);}
  .hero-photo-inner{position:relative;z-index:1;max-width:620px;padding:76px 0;}

  .about-split-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:44px;align-items:center;}
  .about-split-photo{position:relative;border-radius:20px;overflow:hidden;box-shadow:var(--shadow);border:1px solid var(--line);}
  .about-split-photo img{width:100%;height:auto;display:block;}
  .about-split-name{position:absolute;left:16px;bottom:16px;background:rgba(8,27,52,.85);padding:10px 16px;border-radius:12px;}
  .about-split-name h3{color:#fff;font-family:'Fraunces',serif;font-size:16px;font-weight:600;margin-bottom:1px;}
  .about-split-name span{color:rgba(255,255,255,.75);font-size:11px;font-family:'DM Mono',monospace;text-transform:uppercase;letter-spacing:.06em;}
  .eyebrow--light{background:rgba(255,255,255,0.14);border-color:rgba(255,255,255,0.35);color:var(--gold-light);}
  .eyebrow--light::before{background:var(--gold-light);}

  .brand-band{background:var(--navy-deep);}
  .brand-band h2, .brand-band h3{color:#fff;}
  .brand-band p{color:rgba(255,255,255,.72);}
  .brand-band .tooth-illustration{filter:drop-shadow(0 25px 50px rgba(0,0,0,.4));}
  .hero-photo-h1{color:#fff;font-size:clamp(32px,4.6vw,54px);margin-top:16px;font-family:'Fraunces',serif;font-weight:600;line-height:1.08;}
  .hero-photo-h1 em{font-style:italic;color:var(--gold-light);}
  .hero-photo-lead{color:rgba(255,255,255,.85);font-size:17.5px;max-width:46ch;margin:16px 0 28px;}
  .btn-cyan{background:var(--gold);color:#fff;box-shadow:0 12px 26px -12px rgba(31,185,206,.65);}
  .btn-outline-light{background:transparent;border-color:rgba(255,255,255,.6);color:#fff;}
  .btn-outline-light:hover{background:#fff;color:var(--ink);}
  .hero-badge-circle{position:absolute;right:-46px;bottom:-46px;width:170px;height:170px;border-radius:50%;background:var(--gold);display:flex;align-items:center;justify-content:center;color:#fff;font-size:28px;font-weight:700;z-index:1;box-shadow:0 20px 40px -15px rgba(31,185,206,.6);}

  .tooth-block{display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;}
  .tooth-illustration{width:100%;max-width:280px;margin:0 auto;filter:drop-shadow(0 25px 40px rgba(11,37,69,.18));}
  .tooth-photo{border-radius:20px;object-fit:cover;aspect-ratio:1/1;}

  .compare-frame{position:relative;aspect-ratio:948/460;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);background:var(--white);border:1px solid var(--line);}
  .compare-frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  #afterWrap{clip-path:inset(0 50% 0 0);}
  .smile-tag{position:absolute;top:14px;left:14px;font-family:'DM Mono',monospace;font-size:10.5px;text-transform:uppercase;letter-spacing:.08em;padding:5px 11px;border-radius:99px;background:var(--white);border:1px solid var(--line);}
  .smile-tag--after{left:auto;right:14px;background:var(--ink);color:var(--bg);border-color:var(--ink);}
  .compare-controls{margin-top:16px;}
  .compare-range{width:100%;appearance:none;height:4px;border-radius:99px;background:var(--line);}
  .compare-range::-webkit-slider-thumb{appearance:none;width:24px;height:24px;border-radius:50%;background:var(--gold);border:4px solid var(--bg);box-shadow:0 4px 10px rgba(26,23,20,.25);cursor:grab;margin-top:-10px;}
  .compare-range::-moz-range-thumb{width:24px;height:24px;border-radius:50%;background:var(--gold);border:4px solid var(--bg);cursor:grab;}
  .compare-caption{text-align:center;font-size:12.5px;color:var(--ink-faint);margin:10px 0 0;}

  section{padding:56px 0;}
  .section--alt{background:var(--bg-alt);}
  .section--dark{background:var(--ink);color:var(--bg);}
  .section--dark p{color:#C9C3BA;}
  .head{max-width:640px;margin-bottom:32px;}
  .head h2{font-size:clamp(25px,3vw,36px);}

  .strip{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;}
  .strip-item{background:var(--bg);padding:26px 22px;}
  .strip-item .icon-badge{width:44px;height:44px;border-radius:12px;background:rgba(198,150,58,0.14);display:flex;align-items:center;justify-content:center;margin-bottom:14px;}
  .strip-item .icon-badge svg{width:21px;height:21px;color:var(--gold);}
  .strip-item h3{font-size:16.5px;font-family:'Manrope',sans-serif;font-weight:700;margin-bottom:6px;}
  .strip-item p{font-size:13.5px;margin:0;}

  .process{display:grid;grid-template-columns:repeat(4,1fr);gap:26px;}
  .step-top{display:flex;align-items:center;gap:10px;margin-bottom:14px;}
  .step .icon-badge{width:38px;height:38px;border-radius:10px;background:var(--bg-alt);display:flex;align-items:center;justify-content:center;flex:none;}
  .step .icon-badge svg{width:18px;height:18px;color:var(--gold);}
  .step .num{font-family:'DM Mono',monospace;font-size:13px;color:var(--gold);}
  .step h3{font-size:17px;font-family:'Manrope',sans-serif;font-weight:700;margin-bottom:6px;}
  .step p{font-size:14px;margin:0;}

  .gallery-feature{background:var(--white);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);max-width:440px;margin:0 auto;}
  .gallery-feature img{width:100%;}
  .gallery-feature-label{padding:14px 18px;font-weight:700;font-size:13.5px;border-top:1px solid var(--line);text-align:center;}

  .why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
  .why-card{border-radius:16px;overflow:hidden;position:relative;box-shadow:var(--shadow);height:236px;border:1px solid var(--line);}
  .why-card .thumb{width:100%;height:100%;object-fit:cover;display:block;}
  .why-card .label{position:absolute;left:0;right:0;bottom:0;background:linear-gradient(100deg,var(--gold),#D9AE5C);color:#fff;padding:13px 16px;display:flex;align-items:center;gap:10px;}
  .why-card .label svg{width:18px;height:18px;color:#fff;flex:none;}
  .why-card .label span{font-weight:700;font-size:14px;}
  .why-card--doctor{color:#fff;}
  .why-card--doctor .bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
  .why-card--doctor::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(26,23,20,0.08),rgba(26,23,20,0.9));}
  .why-card--doctor .content{position:relative;z-index:1;height:100%;display:flex;flex-direction:column;justify-content:flex-end;padding:18px;}
  .why-card--doctor .avatar{width:48px;height:48px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,.85);margin-bottom:8px;}
  .why-card--doctor h3{color:#fff;font-size:15px;margin-bottom:1px;}
  .why-card--doctor span{font-size:11px;color:rgba(255,255,255,.72);font-family:'DM Mono',monospace;}
  .why-card--doctor p{color:rgba(255,255,255,.85);font-size:12px;margin:7px 0 0;}

  .cert-badge{display:inline-flex;align-items:center;gap:8px;padding:9px 15px;border:1px solid var(--line);border-radius:99px;font-size:12.5px;font-weight:600;background:var(--bg-alt);}
  .cert-badge svg{width:15px;height:15px;color:var(--teal);flex:none;}
  .cert-link{font-size:13px;font-weight:700;text-decoration:underline;color:var(--ink);}

  .treat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
  .tcard{padding:26px;border-radius:16px;background:var(--bg-alt);border:1px solid var(--line);}
  .tcard .icon-badge{width:46px;height:46px;border-radius:12px;background:var(--teal);display:flex;align-items:center;justify-content:center;margin-bottom:14px;}
  .tcard:nth-child(2n) .icon-badge{background:var(--gold);}
  .tcard .icon-badge svg{width:22px;height:22px;color:#fff;}
  .tcard h3{font-family:'Manrope',sans-serif;font-weight:700;font-size:16.5px;margin-bottom:6px;}
  .tcard p{font-size:13.5px;margin:0;}

  .photo-treat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .pcard{border-radius:16px;overflow:hidden;box-shadow:var(--shadow);background:var(--white);border:1px solid var(--line);}
  .pcard .photo-frame{height:255px;width:100%;background:var(--bg-alt);display:flex;align-items:center;justify-content:center;}
  .pcard .photo{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;display:block;}
  .pcard .photo-placeholder{height:210px;width:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--bg-alt),var(--line));color:var(--ink-faint);}
  .pcard .photo-placeholder svg{width:38px;height:38px;}
  .pcard .body{padding:18px 20px;}
  .pcard h3{font-size:16px;margin-bottom:6px;font-weight:700;font-family:'Manrope',sans-serif;color:var(--ink);}
  .pcard p{font-size:13px;margin:0 0 14px;}
  .pcard .link{display:inline-flex;align-items:center;gap:9px;font-size:12.5px;font-weight:700;color:var(--ink);text-decoration:none;}
  .pcard .link .badge{width:26px;height:26px;border-radius:50%;background:var(--gold);display:flex;align-items:center;justify-content:center;flex:none;}
  .pcard .link .badge svg{width:13px;height:13px;color:#fff;}
  .pcard .warranty-tag{margin:0 0 12px;}

  .form-card{background:var(--white);border:1px solid var(--line);border-radius:var(--radius);padding:26px;box-shadow:var(--shadow);}
  .form-card h3{font-size:16px;font-weight:700;margin-bottom:4px;font-family:'Manrope',sans-serif;}
  .form-card .sub{font-size:12.5px;color:var(--ink-faint);margin-bottom:16px;}
  .field{margin-bottom:12px;} .field label{display:block;font-size:12px;font-weight:600;margin-bottom:6px;}
  .field input{width:100%;padding:12px 14px;border:1.5px solid var(--line);border-radius:10px;font-family:'Manrope',sans-serif;font-size:16px;background:var(--bg);}
  .field input:focus{border-color:var(--gold);outline:none;}
  .form-note{font-size:11px;color:var(--ink-faint);margin-top:10px;text-align:center;}
  .form-success{display:none;text-align:center;padding:18px 0;}
  .form-success.show{display:block;}
  .form-success svg{width:32px;height:32px;color:var(--teal);margin:0 auto 12px;}

  footer{padding:0;background:var(--navy-deep);color:#fff;}
  .foot-top{display:grid;grid-template-columns:1.1fr .75fr .75fr 1.3fr;gap:32px;padding:44px 28px;max-width:var(--maxw);margin:0 auto;}
  .foot-brand p{font-size:13px;max-width:36ch;margin-top:12px;color:rgba(255,255,255,.65);}
  .foot-logo-chip{display:inline-flex;align-items:center;justify-content:center;width:64px;height:64px;background:#fff;border-radius:14px;padding:10px;box-shadow:0 8px 20px -8px rgba(0,0,0,.4);}
  .foot-logo-chip img{width:100%;height:auto;}
  .foot-map{max-width:760px;margin:0 auto;padding:0 28px 8px;}
  .foot-map-frame{position:relative;border-radius:14px;overflow:hidden;border:1px solid rgba(255,255,255,.15);}
  .foot-map iframe{width:100%;height:270px;border:0;display:block;}
  .foot-map-tap{position:absolute;right:14px;bottom:14px;background:var(--gold);color:#fff;font-size:12.5px;font-weight:700;padding:9px 14px;border-radius:99px;box-shadow:0 8px 20px -8px rgba(0,0,0,.5);text-decoration:none;}
  .foot-col h4{font-family:'DM Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.45);margin:0 0 10px;}
  .foot-col p, .foot-col a{font-size:13.5px;color:rgba(255,255,255,.75);}
  .foot-col a{text-decoration:none;color:rgba(255,255,255,.8);}
  .foot-col a:hover{color:var(--gold-light);}
  .foot-col ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;}
  .foot-treat-list{columns:2;column-gap:16px;display:block !important;}
  .foot-treat-list li{margin-bottom:8px;break-inside:avoid;}
  .foot-about{border-top:1px solid rgba(255,255,255,.12);padding:32px 28px 8px;max-width:var(--maxw);margin:0 auto;}
  .foot-about h4{font-family:'DM Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:rgba(255,255,255,.45);margin:0 0 12px;}
  .foot-about p{font-size:13.5px;color:rgba(255,255,255,.72);max-width:80ch;margin:0 0 10px;}
  .foot-cert{border-top:1px solid rgba(255,255,255,.12);padding:26px 28px;max-width:var(--maxw);margin:0 auto;display:flex;align-items:center;gap:20px;flex-wrap:wrap;}
  .foot-cert img{width:200px;height:auto;border-radius:10px;border:1px solid rgba(255,255,255,.18);flex:none;}
  .foot-cert a.cert-link{margin-left:auto;color:var(--gold-light);}
  .foot-cert .cert-badge{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.18);color:rgba(255,255,255,.85);}
  .foot-bottom{padding:16px 28px 90px;max-width:var(--maxw);margin:0 auto;font-size:11.5px;color:rgba(255,255,255,.4);}

  .wa-float{position:fixed;bottom:24px;right:24px;z-index:50;}
  .wa-float a{position:relative;display:flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:50%;background:var(--wa);box-shadow:0 14px 30px -10px rgba(47,169,106,.65);}
  .wa-float a svg{width:26px;height:26px;color:#fff;}
  .wa-ring{position:absolute;inset:0;border-radius:50%;border:2px solid var(--wa);animation:ping 2.2s ease-out infinite;}
  @keyframes ping{0%{transform:scale(1);opacity:.7;}100%{transform:scale(1.7);opacity:0;}}

  .reveal{opacity:0;transform:translateY(18px);transition:opacity .6s ease, transform .6s ease;}
  .reveal.is-visible{opacity:1;transform:translateY(0);}

  video{width:100%;border-radius:16px;box-shadow:var(--shadow);background:#000;}

  @media (max-width:980px){
    .nav-address{display:none;}
    .hero-grid{grid-template-columns:1fr;}
    .tooth-block{grid-template-columns:1fr;text-align:center;}
    .tooth-illustration{order:-1;}
    .digital-static{grid-template-columns:1fr;}
    .about-split-grid{grid-template-columns:1fr;}
    .strip{grid-template-columns:repeat(2,1fr);}
    .process{grid-template-columns:repeat(2,1fr);row-gap:30px;}
    .feature-banner{grid-template-columns:1fr;}
    .why-grid{grid-template-columns:1fr;}
    .why-card{height:210px;}
    .team-grid{grid-template-columns:1fr;}
    .reviews-layout{grid-template-columns:1fr;}
    .foot-top{grid-template-columns:1fr;}
    .treat-grid{grid-template-columns:repeat(2,1fr);}
    .photo-treat-grid{grid-template-columns:repeat(2,1fr);}
  }
  @media (max-width:600px){
    .wrap{padding:0 20px;}
    .nav{padding:12px 20px;}
    .nav-links{flex-wrap:wrap;gap:4px;justify-content:center;padding:0 12px 10px;}
    .nav-links a{font-size:12.5px;padding:5px 8px;}
    .strip{grid-template-columns:repeat(2,1fr);}
    .process{grid-template-columns:repeat(2,1fr);row-gap:22px;column-gap:16px;}
    .treat-grid{grid-template-columns:1fr;}
    .photo-treat-grid{grid-template-columns:1fr;}
    section{padding:48px 0;}
    .cta-row{flex-direction:column;align-items:stretch;}
    .foot-cert a.cert-link{margin-left:0;}
  }
</style>
