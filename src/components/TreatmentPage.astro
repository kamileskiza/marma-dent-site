---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getHome, getTreatments, TREATMENT_CONTENT_LOCALES, localesForTreatment } from '../i18n/content';
import { getSeoOverride } from '../i18n/seo-overrides';
import { localePath } from '../i18n/locales';
import { treatmentSlug, TREATMENT_IDS, type TreatmentId } from '../i18n/slugs';
import { TREATMENT_IMAGES } from '../i18n/treatment-images';

export interface Props { locale: string; treatmentId: string; img: string; path: string; }
const { locale, treatmentId, img, path } = Astro.props;
const t = getHome(locale);
const treatments = getTreatments(locale);
const d = treatments[treatmentId];
// Build each locale's own slug for this same treatment, so hreflang/canonical/the
// language switcher point to real, existing pages instead of reusing this locale's slug.
// Only include locales where this specific treatment is actually published — some
// treatments (e.g. emax-veneers) are restricted to a subset via TREATMENT_LOCALES_OVERRIDE.
const treatmentLocales = localesForTreatment(treatmentId);
const slugMap: Record<string, string> = {};
for (const loc of treatmentLocales) {
  slugMap[loc] = `${treatmentSlug(loc, treatmentId as TreatmentId)}/`;
}
const seo = getSeoOverride(locale, treatmentId);
const pageTitle = seo?.title ?? `${d.title} — Nizam Abdullayev Dental Clinic`;
const pageDescription = seo?.description ?? d.tagline;

// Other treatments available in this locale, so a visitor who landed directly on
// this page (e.g. from search) can discover the rest of the site instead of
// having no way back except the homepage.
const otherTreatments = TREATMENT_IDS
  .filter((id) => id !== treatmentId && localesForTreatment(id).includes(locale))
  .map((id) => ({
    id,
    slug: treatmentSlug(locale, id),
    title: treatments[id]?.title ?? id,
    img: TREATMENT_IMAGES[id],
  }));

const EEAT: Record<string, string> = {
  en: 'Medically reviewed by: Dt. Nizam Abdullayev, Dentist. Last updated: 2026. This page is for general information; your personalised treatment plan is determined by clinical examination and imaging.',
  tr: 'İçeriği tıbben inceleyen: Dt. Nizam Abdullayev, Diş Hekimi. Son güncelleme: 2026. Bu sayfa genel bilgilendirme amaçlıdır; kişisel tedavi planınız muayene ve görüntüleme ile belirlenir.',
  ru: 'Медицинский рецензент: Dt. Nizam Abdullayev, стоматолог. Обновлено: 2026. Эта страница носит общий информационный характер; ваш план лечения определяется на очном осмотре.',
  de: 'Medizinisch geprüft von: Dt. Nizam Abdullayev, Zahnarzt. Letzte Aktualisierung: 2026. Diese Seite dient der allgemeinen Information; Ihr individueller Behandlungsplan wird durch klinische Untersuchung und Bildgebung festgelegt.',
  ar: 'راجع المحتوى طبياً: د. نظام عبدالله، طبيب أسنان. آخر تحديث: 2026. هذه الصفحة لأغراض إعلامية عامة؛ يتم تحديد خطة علاجك الشخصية من خلال الفحص السريري والتصوير.',
  az: 'Məzmunu tibbi cəhətdən nəzərdən keçirən: Dt. Nizam Abdullayev, Diş həkimi. Son yenilənmə: 2026. Bu səhifə ümumi məlumat məqsədlidir; şəxsi müalicə planınız müayinə və görüntüləmə ilə müəyyən edilir.',
  uk: 'Медичний рецензент: Dt. Nizam Abdullayev, стоматолог. Оновлено: 2026. Ця сторінка носить загальний інформаційний характер; ваш план лікування визначається під час особистого огляду.',
  bg: 'Медицински преглед от: Dt. Nizam Abdullayev, стоматолог. Последна актуализация: 2026. Тази страница е с обща информационна цел; вашият личен план за лечение се определя чрез клиничен преглед и образна диагностика.',
  nl: 'Medisch beoordeeld door: Dt. Nizam Abdullayev, Tandarts. Laatst bijgewerkt: 2026. Deze pagina is voor algemene informatie; uw persoonlijke behandelplan wordt bepaald door klinisch onderzoek en beeldvorming.',
  fr: 'Contenu revu médicalement par : Dt. Nizam Abdullayev, Chirurgien-dentiste. Dernière mise à jour : 2026. Cette page est à titre informatif général ; votre plan de traitement personnalisé est déterminé par un examen clinique et une imagerie.',
  pl: 'Treść zweryfikowana medycznie przez: Dt. Nizam Abdullayev, Stomatolog. Ostatnia aktualizacja: 2026. Ta strona ma charakter ogólnoinformacyjny; Twój indywidualny plan leczenia zostanie ustalony na podstawie badania klinicznego i obrazowania.',
  ro: 'Conținut revizuit medical de: Dt. Nizam Abdullayev, Medic dentist. Ultima actualizare: 2026. Această pagină are scop informativ general; planul dumneavoastră de tratament personalizat este stabilit prin examinare clinică și imagistică.',
  it: 'Contenuto verificato dal punto di vista medico da: Dt. Nizam Abdullayev, Odontoiatra. Ultimo aggiornamento: 2026. Questa pagina ha finalità puramente informativa; il piano di trattamento personalizzato viene stabilito tramite esame clinico e imaging.',
  el: 'Ιατρική επιμέλεια: Dt. Nizam Abdullayev, Οδοντίατρος. Τελευταία ενημέρωση: 2026. Αυτή η σελίδα είναι για γενική ενημέρωση· το εξατομικευμένο σχέδιο θεραπείας σας καθορίζεται μέσω κλινικής εξέτασης και απεικόνισης.',
  es: 'Contenido revisado médicamente por: Dt. Nizam Abdullayev, Odontólogo. Última actualización: 2026. Esta página tiene fines informativos generales; su plan de tratamiento personalizado se determina mediante examen clínico e imágenes.',
};
---
<BaseLayout locale={locale} title={pageTitle} description={pageDescription} path={path} ogImage={img} availableLocales={treatmentLocales} slugMap={slugMap}>
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t.nav_home, "item": `${Astro.site}${localePath(locale, '')}` },
    { "@type": "ListItem", "position": 2, "name": d.title, "item": `${Astro.site}${localePath(locale, path)}` }
  ]
})} />
  <Header locale={locale} t={t} path={path} availableLocales={treatmentLocales} slugMap={slugMap} />

  <section class="detail-hero">
    <img src={img} alt={d.title} class="zoomable-hero" role="button" tabindex="0" aria-label={t.tap_to_zoom ?? 'Tap to enlarge photo'}>
    <div class="overlay"></div>
    <div class="wrap content">
      <span class="eyebrow">{d.eyebrow}</span>
      <h1>{d.title}</h1>
      <p>{d.tagline}</p>
    </div>
  </section>

  <div class="lightbox" id="hero-lightbox">
    <button class="lightbox-close" aria-label="Close">&times;</button>
    <img src={img} alt={d.title}>
  </div>

  <section class="body">
    <div class="wrap">
      <h2>{t.overview_label ?? 'Overview'}</h2>
      {d.overview?.map((p: string) => <p>{p}</p>)}

      {d.warranty && (
        <div class="warranty-note">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l7 3v6c0 5-3 8.5-7 11-4-2.5-7-6-7-11V5z"/></svg>
          <span>{d.warranty}</span>
        </div>
      )}

      {d.variants && (
        <>
          <h2>{treatmentId === 'all-on-4-5-6' ? (locale === 'tr' ? 'All-on-4, All-on-5 ve All-on-6 Karşılaştırması' : 'Comparing All-on-4, All-on-5 and All-on-6') : ''}</h2>
          {d.variants.map((v: any) => (
            <div class="variant">
              <h3>{v.title}</h3>
              <p class="variant-tagline">{v.tagline}</p>
              <p>{v.desc}</p>
            </div>
          ))}
        </>
      )}

      <h2>{t.who_for_label ?? "Who it's for"}</h2>
      <ul>{d.who_for?.map((li: string) => <li>{li}</li>)}</ul>

      <h2>{t.expect_label ?? 'What to expect'}</h2>
      <ol>{d.expect_steps?.map((li: string) => <li>{li}</li>)}</ol>

      <h2>{t.why_us_label ?? 'Why choose us'}</h2>
      <p>{d.why_us}</p>

      <div class="eeat">{EEAT[locale] ?? EEAT.en}</div>
    </div>
  </section>

  <section class="more-treatments">
    <div class="wrap">
      <h2>{t.more_treatments_label ?? 'Explore other treatments'}</h2>
      <div class="more-treat-grid">
        {otherTreatments.map((ot) => (
          <a class="more-treat-card" href={localePath(locale, ot.slug + '/')}>
            <div class="more-treat-photo"><img src={ot.img} alt={ot.title} loading="lazy" /></div>
            <span>{ot.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap cta-inner">
      <div>
        <h3>{t.cta2_h2 ?? 'Ready to get started?'}</h3>
        <p>{t.cta2_desc ?? ''}</p>
      </div>
      <div class="cta-buttons">
        <a href={localePath(locale, '#plan')} class="btn btn-cyan">{t.cta_plan ?? 'Get my free quote'}</a>
        <a href="https://wa.me/905551901034?text=Hello%2C%20I%20would%20like%20a%20free%20consultation" target="_blank" rel="noopener" class="btn btn-outline">{t.cta_wa ?? 'Chat on WhatsApp'}</a>
      </div>
    </div>
  </section>

  <Footer locale={locale} t={t} />

  <style>
    .detail-hero{position:relative;min-height:320px;display:flex;align-items:flex-end;overflow:hidden;}
    .detail-hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
    .zoomable-hero{cursor:zoom-in;}
    .lightbox{display:none;position:fixed;inset:0;z-index:999;background:rgba(6,16,32,.94);align-items:center;justify-content:center;padding:24px;cursor:zoom-out;}
    .lightbox.open{display:flex;}
    .lightbox img{max-width:100%;max-height:90vh;object-fit:contain;border-radius:8px;box-shadow:0 20px 60px rgba(0,0,0,.5);}
    .lightbox-close{position:absolute;top:18px;right:20px;background:rgba(255,255,255,.12);border:none;color:#fff;width:40px;height:40px;border-radius:50%;font-size:26px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;}
    .lightbox-close:hover{background:rgba(255,255,255,.22);}
    .overlay{position:absolute;inset:0;background:linear-gradient(0deg, rgba(8,27,52,.92) 0%, rgba(8,27,52,.5) 55%, rgba(8,27,52,.15) 100%);}
    .content{position:relative;z-index:1;padding:46px 24px 30px;color:#fff;}
    .eyebrow{display:inline-flex;font-family:'DM Mono',monospace;font-size:11px;text-transform:uppercase;color:var(--gold-light);background:rgba(255,255,255,.14);padding:6px 12px;border-radius:99px;}
    .content h1{color:#fff;font-size:clamp(24px,4vw,34px);margin-top:12px;}
    .content p{color:rgba(255,255,255,.85);font-size:14.5px;margin-top:8px;max-width:60ch;}
    .body{padding:40px 24px;max-width:820px;margin:0 auto;}
    .body h2{font-size:19px;margin:30px 0 12px;}
    .body h2:first-child{margin-top:0;}
    .body p{font-size:14px;color:var(--ink-soft);margin:0 0 12px;}
    .body ul, .body ol{padding-left:20px;font-size:14px;color:var(--ink-soft);}
    .body li{margin-bottom:8px;}
    .warranty-note{display:flex;gap:10px;align-items:center;background:var(--bg-alt);border:1px solid var(--line);border-radius:14px;padding:14px 16px;font-size:13px;margin:16px 0;}
    .warranty-note svg{width:20px;height:20px;color:var(--gold);flex:none;}
    .variant{background:var(--bg-alt);border-radius:14px;padding:16px 18px;margin-bottom:12px;border:1px solid var(--line);}
    .variant h3{font-size:15px;margin-bottom:4px;}
    .variant-tagline{font-weight:600;color:var(--ink);font-size:13px;}
    .eeat{margin-top:34px;padding-top:16px;border-top:1px solid var(--line);font-size:11.5px;color:var(--ink-faint);}
    .more-treatments{background:var(--bg-alt);padding:40px 0;}
    .more-treatments .wrap{max-width:1040px;}
    .more-treatments h2{font-size:19px;margin-bottom:18px;}
    .more-treat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
    .more-treat-card{display:flex;flex-direction:column;text-decoration:none;background:var(--white);border:1px solid var(--line);border-radius:14px;overflow:hidden;transition:box-shadow .15s ease,transform .15s ease;}
    .more-treat-card:hover{box-shadow:var(--shadow);transform:translateY(-2px);}
    .more-treat-photo{height:110px;background:var(--bg-alt);display:flex;align-items:center;justify-content:center;}
    .more-treat-photo img{width:100%;height:100%;object-fit:cover;display:block;}
    .more-treat-card span{padding:10px 12px;font-size:13px;font-weight:600;color:var(--ink);}
    @media (max-width:900px){ .more-treat-grid{grid-template-columns:repeat(3,1fr);} }
    @media (max-width:640px){ .more-treat-grid{grid-template-columns:repeat(2,1fr);} }
    .cta{background:var(--navy-deep);padding:36px 0;}
    .cta-inner{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:20px;}
    .cta h3{color:#fff;font-size:18px;}
    .cta p{color:rgba(255,255,255,.7);font-size:13px;margin-top:4px;}
    .cta-buttons{display:flex;gap:12px;flex-wrap:wrap;}
    .btn{display:inline-flex;padding:12px 20px;border-radius:99px;font-size:13px;font-weight:700;}
    .btn-cyan{background:var(--gold);color:#fff;}
    .btn-outline{border:1px solid rgba(255,255,255,.5);color:#fff;}
  </style>

  <script>
    const heroImg = document.querySelector('.zoomable-hero');
    const lightbox = document.getElementById('hero-lightbox');
    const closeBtn = lightbox?.querySelector('.lightbox-close');
    function openLightbox() { lightbox?.classList.add('open'); document.body.style.overflow = 'hidden'; }
    function closeLightbox() { lightbox?.classList.remove('open'); document.body.style.overflow = ''; }
    heroImg?.addEventListener('click', openLightbox);
    heroImg?.addEventListener('keypress', (e) => { if ((e as KeyboardEvent).key === 'Enter') openLightbox(); });
    closeBtn?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });
  </script>
</BaseLayout>
