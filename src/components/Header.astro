---
import { LOCALES, localePath } from '../i18n/locales';

export interface Props {
  locale: string;
  t: Record<string, string>;
  path?: string;
  availableLocales?: string[];
  slugMap?: Record<string, string>; // locale -> that locale's own path for this content; see BaseLayout.
  showInstagram?: boolean;
}
const { locale, t, path = '', availableLocales, slugMap, showInstagram = false } = Astro.props;
const current = LOCALES.find((l) => l.code === locale) ?? LOCALES[0];
const others = LOCALES.filter((l) => l.code !== locale);

function targetHref(code: string): string {
  if (availableLocales && !availableLocales.includes(code)) {
    return localePath(code);
  }
  if (slugMap) {
    // Only link to another locale's own slug if we actually know it; otherwise send
    // the visitor to that locale's homepage rather than a guessed, possibly-broken URL.
    return localePath(code, code in slugMap ? slugMap[code] : '');
  }
  return localePath(code, path);
}
---
<header>
  <div class="nav wrap">
    <a href={localePath(locale, path || '#top')} class="brand">
      <img src="/images/logo.png" alt="Nizam Abdullayev Dental Clinic">
    </a>
    <div class="nav-address">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-6-5.2-6-10a6 6 0 0112 0c0 4.8-6 10-6 10z"/><circle cx="12" cy="11" r="2.2"/></svg>
      <a href="https://www.google.com/maps/place//data=!4m2!3m1!1s0x14cac7e750160475:0xf5753de54ca605bc?sa=X&ved=1t:8290&ictx=111" target="_blank" rel="noopener">{t.trust_bar_address}</a>
    </div>
    <div class="nav-right">
      {showInstagram && (
        <a class="btn-ig-top" href="https://www.instagram.com/dtnizamabdullayev" target="_blank" rel="noopener" title="Instagram" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
        </a>
      )}
      <div class="lang-switch" id="langSwitch">
        <button class="lang-trigger" id="langTrigger" type="button" aria-haspopup="listbox" aria-expanded="false">
          <span class="flag">{current.flag}</span><span>{current.code.toUpperCase()}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="lang-menu" id="langMenu" role="listbox">
          {LOCALES.map((l) => (
            <a href={targetHref(l.code)} role="option" class:list={{active: l.code === locale}}>
              <span>{l.flag}</span><span>{l.name}</span>
            </a>
          ))}
        </div>
      </div>
      <a class="btn btn-cyan" href={localePath(locale, '#plan')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="2"></rect><path d="M8 8h8M8 12h8M8 16h5"></path></svg>
        <span>{t.nav_get_plan}</span>
      </a>
    </div>
  </div>
  <div class="nav-links wrap">
    <a href={localePath(locale, '#top')}>{t.nav_home}</a>
    <a href={localePath(locale, 'blog/')}>Blog</a>
    <a href={localePath(locale, '#certificates')}>{t.nav_certificates}</a>
    <a href={localePath(locale, '#reviews')}>{t.nav_reviews}</a>
    <a href={localePath(locale, '#about')}>{t.nav_about}</a>
    <a href={localePath(locale, '#plan')}>{t.nav_contact}</a>
  </div>
</header>

<style>
  .lang-menu a{display:flex;align-items:center;gap:10px;width:100%;text-align:left;padding:10px 11px;border:none;background:transparent;font-family:'Manrope',sans-serif;font-size:13.5px;cursor:pointer;border-radius:9px;color:var(--ink);text-decoration:none;}
  .lang-menu a:hover{background:var(--bg-alt);}
  .lang-menu a.active{background:var(--bg-alt);font-weight:700;}
  .flag{font-size:16px;line-height:1;}
  .btn-ig-top{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:linear-gradient(45deg,#feda75,#fa7e1e,#d62976,#962fbf,#4f5bd5);color:#fff;}
  .btn-ig-top svg{width:17px;height:17px;}
</style>

<script>
  const menu = document.getElementById('langMenu');
  const trigger = document.getElementById('langTrigger');
  trigger?.addEventListener('click', (e) => { e.stopPropagation(); menu?.classList.toggle('open'); });
  document.addEventListener('click', () => menu?.classList.remove('open'));
</script>
