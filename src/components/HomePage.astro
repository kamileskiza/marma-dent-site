---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getHome, getTreatments, TREATMENT_CONTENT_LOCALES, localesForTreatment } from '../i18n/content';
import { getHomeSeo } from '../i18n/home-seo';
import { localePath } from '../i18n/locales';
import { treatmentSlug } from '../i18n/slugs';

export interface Props { locale: string; }
const { locale } = Astro.props;
const t = getHome(locale);
const waLink = `https://wa.me/905551901034?text=${encodeURIComponent(t.wa_message ?? 'Hello, I would like a free consultation')}`;
const seo = getHomeSeo(locale);
const pageTitle = seo?.title ?? `${t.hero_h1?.replace(/<[^>]+>/g,'') ?? 'Nizam Abdullayev Dental Clinic'} — Istanbul`;
const pageDescription = seo?.description ?? t.hero_lead ?? '';
const hasTreatmentPages = TREATMENT_CONTENT_LOCALES.includes(locale);
const treatments = getTreatments(locale);
const linkLocale = hasTreatmentPages ? locale : 'en';

const treatCards: Array<{ id: string; img: string; title: string; desc: string; warranty?: boolean }> = [
  { id: 'all-on-4-5-6', img: '/images/all-on-4.jpg', title: treatments['all-on-4-5-6']?.title ?? 'All-on-4/5/6', desc: treatments['all-on-4-5-6']?.tagline ?? '', warranty: true },
  { id: 'hollywood-smile', img: '/images/hollywood-smile.jpg', title: treatments['hollywood-smile']?.title ?? 'Hollywood Smile', desc: treatments['hollywood-smile']?.tagline ?? '' },
  { id: 'emax-veneers', img: '/images/emax-veneers-smile.jpg', title: treatments['emax-veneers']?.title ?? 'E-max Veneers', desc: treatments['emax-veneers']?.tagline ?? '' },
  { id: 'monolithic-zirconia', img: '/images/monolithic-zirconia.jpg', title: treatments['monolithic-zirconia']?.title ?? 'Monolithic Zirconia', desc: treatments['monolithic-zirconia']?.tagline ?? '', warranty: true },
  { id: 'dental-implants', img: '/images/dental-implants.jpg', title: treatments['dental-implants']?.title ?? 'Dental Implants', desc: treatments['dental-implants']?.tagline ?? '', warranty: true },
  { id: 'zygomatic-implants', img: '/images/zygomatic-implants.png', title: treatments['zygomatic-implants']?.title ?? 'Zygomatic Implants', desc: treatments['zygomatic-implants']?.tagline ?? '', warranty: true },
  { id: 'dental-bridge', img: '/images/dental-bridge.jpg', title: treatments['dental-bridge']?.title ?? 'Dental Bridge', desc: treatments['dental-bridge']?.tagline ?? '', warranty: true },
  { id: 'invisalign', img: '/images/invisalign.png', title: treatments['invisalign']?.title ?? 'Invisalign', desc: treatments['invisalign']?.tagline ?? '' },
  { id: 'digital-smile-design', img: '/images/digital-smile-design.jpg', title: treatments['digital-smile-design']?.title ?? 'Digital Smile Design', desc: treatments['digital-smile-design']?.tagline ?? '' },
  { id: 'teeth-whitening', img: '/images/teeth-whitening.jpg', title: treatments['teeth-whitening']?.title ?? 'Teeth Whitening', desc: treatments['teeth-whitening']?.tagline ?? '' },
  { id: 'screw-retained-occlusal', img: '/images/screw-retained.jpg', title: treatments['screw-retained-occlusal']?.title ?? 'Screw-Retained System', desc: treatments['screw-retained-occlusal']?.tagline ?? '' },
  { id: 'gingivectomy', img: '/images/gingivectomy.jpg', title: treatments['gingivectomy']?.title ?? 'Gingivectomy', desc: treatments['gingivectomy']?.tagline ?? '' },
  { id: 'sinus-lift', img: '/images/sinus-lift.jpg', title: treatments['sinus-lift']?.title ?? 'Sinus Lift', desc: treatments['sinus-lift']?.tagline ?? '' },
  { id: 'root-canal-therapy', img: '/images/root-canal.jpg', title: treatments['root-canal-therapy']?.title ?? 'Root Canal Therapy', desc: treatments['root-canal-therapy']?.tagline ?? '' },
  { id: 'full-denture', img: '/images/full-denture.webp', title: treatments['full-denture']?.title ?? 'Full Denture', desc: treatments['full-denture']?.tagline ?? '' },
  { id: 'orthodontics', img: '/images/orthodontics.jpg', title: treatments['orthodontics']?.title ?? 'Orthodontics & Braces', desc: treatments['orthodontics']?.tagline ?? '' },
];

function tp(id: string) {
  const idLocale = localesForTreatment(id).includes(locale) ? locale : 'en';
  return localePath(idLocale, treatmentSlug(idLocale, id as any) + '/');
}
---
<BaseLayout locale={locale} title={pageTitle} description={pageDescription} path="">
<!-- Review rating markup lives only here, on the page that actually displays the
     reviews section — not repeated across every treatment/blog page. -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Dentist",
  "@id": `https://dtnizamabdullayev.com/#clinic`,
  "aggregateRating": {"@type":"AggregateRating","ratingValue":"5","reviewCount":"89"}
})} />
<Header locale={locale} t={t} path="" showInstagram={true} />

<main>

  <!-- HERO -->
  <section class="hero-photo">
    <img class="hero-photo-bg" src="/images/clinic-room.jpg" alt="">
    <div class="hero-photo-overlay"></div>
    <div class="wrap hero-photo-inner">
      <span class="eyebrow eyebrow--light">{t.eyebrow}</span>
      <h1 class="hero-photo-h1" set:html={t.hero_h1}></h1>
      <p class="hero-photo-lead">{t.hero_lead}</p>
      <div class="cta-row">
        <a href={localePath(locale, '#plan')} class="btn btn-cyan">{t.cta_plan}</a>
        <a href={waLink} target="_blank" rel="noopener" class="btn btn-outline-light">{t.cta_wa}</a>
      </div>
    </div>
  </section>

  <!-- HEALTHY SMILES -->
  {t.tooth_h2 && (
    <section class="brand-band">
      <div class="wrap tooth-block reveal">
        <div>
          <span class="eyebrow eyebrow--light">{t.tooth_eyebrow}</span>
          <h2 style="margin-top:14px;">{t.tooth_h2}</h2>
          <p>{t.tooth_desc}</p>
          <a href={localePath(locale, '#treatments')} class="btn btn-outline-light">{t.tooth_cta}</a>
        </div>
        <img src="/images/healthy-smiles.jpg" alt="Happy patient checking her smile" class="tooth-illustration tooth-photo" loading="lazy">
      </div>
    </section>
  )}

  <!-- DIGITAL WORKFLOW STANDALONE -->
  {t.digital_big_title && (
    <section style="padding-top:0;">
      <div class="wrap digital-static reveal">
        <div class="digital-static-photo"><img src="/images/itero-scanner.jpg" alt="iTero digital scanner" loading="lazy"></div>
        <div>
          <div class="fb-icon fb-icon--static"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h5"/></svg></div>
          <h3>{t.digital_big_title}</h3>
          <p>{t.digital_big_desc}</p>
        </div>
      </div>
    </section>
  )}

  <!-- TREATMENTS -->
  <section id="treatments" class="section--alt">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">{t.treat_eyebrow}</span>
        <h2 style="margin-top:14px;">{t.treat_h2}</h2>
      </div>
      <div class="photo-treat-grid reveal" id="treat-grid">
        {treatCards.map((c, i) => (
          <div class="pcard" data-extra={i >= 6 ? "true" : "false"}>
            <div class="photo-frame"><img class="photo" src={c.img} alt={c.title} loading="lazy"></div>
            <div class="body">
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
              {c.warranty && (
                <div class="warranty-tag">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l7 3v6c0 5-3 8.5-7 11-4-2.5-7-6-7-11V5z"/></svg>
                  <span>{t.warranty_tag}</span>
                </div>
              )}
              <a class="link" href={tp(c.id)}>
                <span class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></span>
                <span>{t.learn_more}</span>
              </a>
            </div>
          </div>
        ))}
      </div>
      {treatCards.length > 6 && (
        <button type="button" id="treat-toggle" class="treat-toggle-btn">
          <span data-label-more>{t.show_all_treatments ?? 'Show all treatments'} (+{treatCards.length - 6})</span>
          <span data-label-less style="display:none;">{t.show_less ?? 'Show less'}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
      )}
      <p class="special-care">{t.special_care}</p>
    </div>
  </section>

  <style>
    .pcard[data-extra="true"]{display:none;}
    #treat-grid.show-all .pcard[data-extra="true"]{display:flex;}
    .treat-toggle-btn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;max-width:340px;margin:8px auto 0;padding:13px 24px;border-radius:99px;border:1.5px solid var(--line);background:var(--bg);color:var(--ink);font-size:14px;font-weight:700;cursor:pointer;transition:background .15s;}
    .treat-toggle-btn:hover{background:var(--bg-alt);}
    .treat-toggle-btn svg{width:16px;height:16px;transition:transform .2s;}
    .treat-toggle-btn.open svg{transform:rotate(180deg);}
  </style>

  <script>
    (function(){
      const btn = document.getElementById('treat-toggle');
      const grid = document.getElementById('treat-grid');
      if (!btn || !grid) return;
      btn.addEventListener('click', function () {
        const open = grid.classList.toggle('show-all');
        btn.classList.toggle('open', open);
        const more = btn.querySelector('[data-label-more]') as HTMLElement | null;
        const less = btn.querySelector('[data-label-less]') as HTMLElement | null;
        if (more) more.style.display = open ? 'none' : '';
        if (less) less.style.display = open ? '' : 'none';
        if (!open) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    })();
  </script>

  <!-- BEFORE / AFTER -->
  {t.gallery2_h2 && (
    <section class="section--alt">
      <div class="wrap">
        <div class="head reveal" style="margin:0 auto 32px;text-align:center;">
          <span class="eyebrow">{t.gallery2_eyebrow}</span>
          <h2 style="margin-top:14px;">{t.gallery2_h2}</h2>
        </div>
        <div class="reveal ba-gallery-grid">
          <img src="/images/before-after-1.jpg" alt="Before and after case 1" loading="lazy">
          <img src="/images/before-after-2.jpg" alt="Before and after case 2" loading="lazy">
        </div>
      </div>
    </section>
  )}

  <!-- ACCOMMODATION / TRANSFER / RESULT -->
  {t.accommodation_title && (
    <section class="brand-band" style="padding-top:56px;">
      <div class="wrap">
        <div class="feature-banner reveal">
          <div class="fcard">
            <div class="fcard-photo"><img src="/images/accommodation.jpg" alt="Partner hotel accommodation" loading="lazy"></div>
            <div class="fcard-body">
              <div class="fb-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21v-7a4 4 0 014-4h10a4 4 0 014 4v7M3 21h18M7 10V6a2 2 0 012-2h6a2 2 0 012 2v4"/></svg></div>
              <h3>{t.accommodation_title}</h3>
              <p>{t.accommodation_desc}</p>
            </div>
          </div>
          <div class="fcard">
            <div class="fcard-photo"><img src="/images/transfer.jpg" alt="Private transfer vehicle in Istanbul" loading="lazy"></div>
            <div class="fcard-body">
              <div class="fb-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 16l7-2 4-9 2 1-3 8 6-1 2 2-8 3-3 5-2-1 2-4z"/></svg></div>
              <h3>{t.transfer_big_title}</h3>
              <p>{t.transfer_big_desc}</p>
            </div>
          </div>
          <div class="fcard">
            <div class="fcard-photo"><img src="/images/result.jpg" alt="Happy patient after treatment" loading="lazy"></div>
            <div class="fcard-body">
              <div class="fb-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M8 13s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"/></svg></div>
              <h3>{t.result_title}</h3>
              <p>{t.result_desc}</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- OBJECTION STRIP -->
  <section style="padding-top:0;">
    <div class="wrap reveal">
      <div class="strip">
        <div class="strip-item">
          <div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M9 15l6-6M9.5 9.5h.01M14.5 14.5h.01"/></svg></div>
          <h3>{t.strip1_title}</h3><p>{t.strip1_desc}</p>
        </div>
        <div class="strip-item">
          <div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 3h6v3H9zM8.5 12l2 2 4-4"/></svg></div>
          <h3>{t.strip2_title}</h3><p>{t.strip2_desc}</p>
        </div>
        <div class="strip-item">
          <div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l7 3v6c0 5-3 8.5-7 11-4-2.5-7-6-7-11V5z"/><path d="M9 12l2 2 4-4"/></svg></div>
          <h3>{t.lifetime_title}</h3><p>{t.lifetime_desc}</p>
        </div>
        <div class="strip-item">
          <div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="3.2"/><path d="M5 20c0-3.3 3.1-6 7-6s7 2.7 7 6"/><path d="M18 4l1.3 1.3L22 3"/></svg></div>
          <h3>{t.routing_title}</h3><p>{t.routing_desc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  {t.process_h2 && (
    <section class="section--alt">
      <div class="wrap">
        <div class="head reveal">
          <span class="eyebrow">{t.process_eyebrow}</span>
          <h2 style="margin-top:14px;">{t.process_h2}</h2>
        </div>
        <div class="process reveal">
          <div class="step">
            <div class="step-top"><div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4z"/></svg></div><span class="num">01</span></div>
            <h3>{t.step1_title}</h3><p>{t.step1_desc}</p>
          </div>
          <div class="step">
            <div class="step-top"><div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h5"/></svg></div><span class="num">02</span></div>
            <h3>{t.step2_title}</h3><p>{t.step2_desc}</p>
          </div>
          <div class="step">
            <div class="step-top"><div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 16l7-2 4-9 2 1-3 8 6-1 2 2-8 3-3 5-2-1 2-4z"/></svg></div><span class="num">03</span></div>
            <h3>{t.step3_title}</h3><p>{t.step3_desc}</p>
          </div>
          <div class="step">
            <div class="step-top"><div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21v-7a4 4 0 014-4h10a4 4 0 014 4v7M3 21h18M7 10V6a2 2 0 012-2h6a2 2 0 012 2v4"/></svg></div><span class="num">04</span></div>
            <h3>{t.step4_title}</h3><p>{t.step4_desc}</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ABOUT / DOCTOR -->
  {t.about_label && (
    <section class="section--alt" id="about">
      <div class="wrap about-split-grid reveal">
        <div class="about-split-photo">
          <img src="/images/doctor.jpg" alt="Dt. Nizam Abdullayev" loading="lazy">
          <div class="about-split-name">
            <h3>Dt. Nizam Abdullayev</h3>
            <span>{t.team_role}</span>
          </div>
        </div>
        <div>
          <span class="eyebrow">{t.about_label}</span>
          <h2 style="margin-top:14px;">{t.team_h2}</h2>
          <p>{t.about_p1}</p>
          <p>{t.about_p2}</p>
          <p>{t.about_p3}</p>
        </div>
      </div>
    </section>
  )}

  <!-- REVIEWS -->
  <section id="reviews">
    <div class="wrap reviews-layout reveal">
      <div>
        <span class="eyebrow">{t.reviews_eyebrow}</span>
        <h2 style="margin-top:14px;">{t.reviews_h2}</h2>
        <div class="review-platforms">
          <div class="platform-badge"><svg viewBox="0 0 48 48" width="20" height="20"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.5 6.5 29.6 4.5 24 4.5 13.5 4.5 5 13 5 23.5S13.5 42.5 24 42.5 43 34 43 23.5c0-1.3-.1-2.6-.4-3.8z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 13.5 24 13.5c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.5 7.5 29.6 5.5 24 5.5c-7.4 0-13.7 4.1-17 10.2z"/><path fill="#4CAF50" d="M24 43.5c5.5 0 10.4-1.9 14.2-5l-6.6-5.6c-2 1.5-4.6 2.4-7.6 2.4-5.2 0-9.6-3.4-11.2-8.1l-6.6 5.1C9.3 39 16 43.5 24 43.5z"/><path fill="#1976D2" d="M43.6 20.5H24v8h11.3c-.8 2.4-2.3 4.4-4.3 5.9l6.6 5.6C41.9 37 44 30.9 44 23.5c0-1.3-.1-2.6-.4-3.8z"/></svg> Google</div>
          <div class="platform-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M2 12h20M12 2a15 15 0 010 20 15 15 0 010-20z"/></svg> Infobel</div>
        </div>
        <div class="review-score"><span class="count-num" data-count-to="5">5</span> <span>/5</span></div>
        <p class="review-score-label">{t.review_score_label}</p>
        <p class="review-count"><span class="count-num" data-count-to="89">89</span> <span>{t.review_count_label}</span></p>
        <p style="font-size:12.5px;color:var(--ink-faint);margin:-10px 0 18px;">{t.review_count2}</p>
        <a href={waLink} target="_blank" rel="noopener" class="btn btn-wa">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20zm4.4-5.9c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1s-.6.8-.8 1c-.1.1-.3.2-.5.1-.2-.1-1-.4-2-1.2-.7-.7-1.2-1.5-1.4-1.7-.1-.2 0-.4.1-.5l.4-.4.2-.4c.1-.1.1-.3 0-.4-.1-.1-.5-1.3-.7-1.8-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.8 2.3.9 2.5c.1.2 1.6 2.5 3.9 3.4.5.2 1 .4 1.3.5.5.2 1 .1 1.4.1.4-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1z"/></svg>
          <span>{t.cta_wa}</span>
        </a>
      </div>
      <div class="review-note-card" style="border-style:solid;">
        <div class="stars" style="color:var(--gold);letter-spacing:2px;font-size:16px;">★★★★★</div>
        <p style="font-size:15px;color:var(--ink);">{t.review1_quote}</p>
        <p style="display:flex;align-items:center;gap:7px;font-family:'DM Mono',monospace;font-size:13px;color:var(--ink-faint);margin:0;">
          <svg viewBox="0 0 48 48" width="15" height="15"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.5 6.5 29.6 4.5 24 4.5 13.5 4.5 5 13 5 23.5S13.5 42.5 24 42.5 43 34 43 23.5c0-1.3-.1-2.6-.4-3.8z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 13.5 24 13.5c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.5 7.5 29.6 5.5 24 5.5c-7.4 0-13.7 4.1-17 10.2z"/><path fill="#4CAF50" d="M24 43.5c5.5 0 10.4-1.9 14.2-5l-6.6-5.6c-2 1.5-4.6 2.4-7.6 2.4-5.2 0-9.6-3.4-11.2-8.1l-6.6 5.1C9.3 39 16 43.5 24 43.5z"/><path fill="#1976D2" d="M43.6 20.5H24v8h11.3c-.8 2.4-2.3 4.4-4.3 5.9l6.6 5.6C41.9 37 44 30.9 44 23.5c0-1.3-.1-2.6-.4-3.8z"/></svg>
          <span>{t.review1_author}</span>
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section--alt">
    <div class="wrap">
      <div class="head reveal" style="margin:0 auto 32px;text-align:center;">
        <span class="eyebrow">{t.faq_eyebrow}</span>
        <h2 style="margin-top:14px;">{t.faq_h2}</h2>
      </div>
      <div class="accordion reveal">
        {[1,2,3,4,5].map((n) => (
          <div class="acc-item">
            <button class="acc-trigger" type="button" aria-expanded="false">
              <span class="acc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M9 15l6-6M9.5 9.5h.01M14.5 14.5h.01"/></svg></span>
              <span class="acc-title">{t[`faq${n}_q`]}</span>
              <svg class="acc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="acc-panel"><p>{t[`faq${n}_a`]}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA + FORM -->
  <section id="plan" class="section--dark">
    <div class="wrap">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;" class="plan-cols">
        <div class="reveal">
          <span class="eyebrow" style="color:var(--gold-light);border-color:rgba(232,203,134,.3);background:rgba(232,203,134,.08);">{t.cta2_eyebrow}</span>
          <h2 style="margin-top:16px;">{t.cta2_h2}</h2>
          <p>{t.cta2_desc}</p>
          <div style="display:flex;flex-direction:column;gap:12px;align-items:flex-start;">
            <a href={waLink} target="_blank" rel="noopener" class="btn btn-wa">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20zm4.4-5.9c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1s-.6.8-.8 1c-.1.1-.3.2-.5.1-.2-.1-1-.4-2-1.2-.7-.7-1.2-1.5-1.4-1.7-.1-.2 0-.4.1-.5l.4-.4.2-.4c.1-.1.1-.3 0-.4-.1-.1-.5-1.3-.7-1.8-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.8 2.3.9 2.5c.1.2 1.6 2.5 3.9 3.4.5.2 1 .4 1.3.5.5.2 1 .1 1.4.1.4-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1z"/></svg>
              <span>{t.cta2_wa}</span>
            </a>
            <a href="tel:+905551901034" class="btn btn-call">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.4 2.1L8 9.9a16 16 0 0 0 6 6l1.4-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.8 2z"/></svg>
              <span>{t.cta_call}</span>
            </a>
          </div>
        </div>
        {t.form_title && (
          <div class="form-card reveal">
            <div id="formDefault">
              <h3>{t.form_title}</h3>
              <div class="sub">{t.form_sub}</div>
              <form id="leadForm" name="lead" method="POST" data-netlify="true" netlify-honeypot="bot-field">
                <input type="hidden" name="form-name" value="lead" />
                <input type="hidden" name="locale" value={locale} />
                <p style="position:absolute;left:-9999px;" aria-hidden="true"><label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
                <div class="field"><label for="name">{t.form_name}</label><input id="name" name="name" type="text" required placeholder="Jane Miller"></div>
                <div class="field">
                  <label for="phone">{t.form_phone}</label>
                  <div class="phone-row">
                    <div class="cc-picker" id="ccPicker" data-locale={locale}>
                      <button type="button" class="phone-code cc-btn" id="ccBtn" aria-haspopup="listbox" aria-expanded="false" aria-controls="ccPanel" aria-label="Country code">
                        <span class="cc-flag" id="ccFlag">🇬🇧</span><span class="cc-dial" id="ccDial">+44</span>
                        <svg class="cc-caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </button>
                      <div class="cc-panel" id="ccPanel" hidden>
                        <input type="text" id="ccSearch" class="cc-search" autocomplete="off" spellcheck="false" aria-label="Search country" aria-controls="ccList">
                        <ul class="cc-list" id="ccList" role="listbox" aria-label="Countries"></ul>
                      </div>
                    </div>
                    <input type="hidden" id="phoneCode" value="+44">
                    <input id="phoneNumber" type="tel" required placeholder="7911 123456" inputmode="tel">
                  </div>
                  <input type="hidden" id="phone" name="phone">
                </div>
                <button type="submit" class="btn btn-gold btn-block">{t.form_submit}</button>
              </form>
              <p class="form-note">{t.form_note}</p>
            </div>
            <div class="form-success" id="formSuccess">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
              <h3>{t.form_success_title}</h3>
              <p style="margin:0;">{t.form_success_desc}</p>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

</main>

<Footer locale={locale} t={t} />

<style>
  .privacy-section h4{font-family:'DM Mono',monospace;font-size:11px;text-transform:uppercase;color:var(--ink-faint);margin-bottom:12px;}
  .privacy-section p{font-size:12.5px;color:var(--ink-soft);max-width:800px;}
  .privacy-note{font-size:11px;color:var(--ink-faint);margin-top:14px;}
  @media (max-width:900px){ .plan-cols{grid-template-columns:1fr !important;} }
</style>
<style is:global>
  .cc-picker{position:relative;flex:none;}
  .cc-btn{display:flex;align-items:center;gap:6px;width:auto;min-width:108px;height:100%;cursor:pointer;color:var(--ink,#1a1a1a);text-align:left;}
  .cc-flag{font-size:20px;line-height:1;}
  .cc-dial{font-variant-numeric:tabular-nums;}
  .cc-caret{width:12px;height:12px;margin-left:auto;opacity:.6;}
  .cc-panel{position:absolute;z-index:60;top:calc(100% + 6px);left:0;width:min(320px,86vw);background:var(--bg,#fff);border:1.5px solid var(--line,#ddd);border-radius:12px;box-shadow:0 12px 32px rgba(0,0,0,.14);padding:8px;}
  [dir="rtl"] .cc-panel{left:auto;right:0;}
  .cc-search{width:100%;box-sizing:border-box;padding:10px 12px;border:1.5px solid var(--line,#ddd);border-radius:8px;font-family:'Manrope',sans-serif;font-size:16px;background:var(--bg,#fff);color:inherit;}
  .cc-search:focus{border-color:var(--gold,#C9A24B);outline:none;}
  .cc-list{list-style:none;margin:6px 0 0;padding:0;max-height:260px;overflow-y:auto;overscroll-behavior:contain;}
  .cc-list li{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:8px;cursor:pointer;font-size:14.5px;}
  .cc-list li[aria-selected="true"],.cc-list li.cc-active{background:rgba(201,162,75,.14);}
  .cc-list li .cc-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .cc-list li .cc-code{color:var(--ink-faint,#888);font-variant-numeric:tabular-nums;}
  .cc-list .cc-sep{height:1px;background:var(--line,#ddd);margin:6px 4px;padding:0;cursor:default;}
  .cc-list .cc-empty{color:var(--ink-faint,#888);cursor:default;}
</style>

<script>
  document.querySelectorAll('.acc-trigger').forEach(function(btn){
    btn.addEventListener('click', function(){
      const item = btn.closest('.acc-item');
      if (!item) return;
      const wasOpen = item.classList.contains('open');
      document.querySelectorAll('.acc-item.open').forEach(function(i){
        i.classList.remove('open');
        i.querySelector('.acc-trigger')?.setAttribute('aria-expanded','false');
      });
      if(!wasOpen){ item.classList.add('open'); btn.setAttribute('aria-expanded','true'); }
    });
  });

  // ---- Phone country-code picker: flag list, searchable by country name (any language) or dial code ----
  (function initCountryPicker(){
    const picker = document.getElementById('ccPicker');
    const btn = document.getElementById('ccBtn');
    const panel = document.getElementById('ccPanel');
    const search = document.getElementById('ccSearch') as HTMLInputElement | null;
    const list = document.getElementById('ccList');
    const flagEl = document.getElementById('ccFlag');
    const dialEl = document.getElementById('ccDial');
    const codeInput = document.getElementById('phoneCode') as HTMLInputElement | null;
    const numInput = document.getElementById('phoneNumber') as HTMLInputElement | null;
    if (!picker || !btn || !panel || !search || !list || !flagEl || !dialEl || !codeInput) return;

    // ISO 3166-1 alpha-2 : international dialling code (digits only)
    const RAW = 'AF93 AL355 DZ213 AS1684 AD376 AO244 AI1264 AG1268 AR54 AM374 AW297 AU61 AT43 AZ994 BS1242 BH973 BD880 BB1246 BY375 BE32 BZ501 BJ229 BM1441 BT975 BO591 BA387 BW267 BR55 VG1284 BN673 BG359 BF226 BI257 KH855 CM237 CA1 CV238 KY1345 CF236 TD235 CL56 CN86 CO57 KM269 CG242 CD243 CK682 CR506 CI225 HR385 CU53 CW599 CY357 CZ420 DK45 DJ253 DM1767 DO1809 EC593 EG20 SV503 GQ240 ER291 EE372 SZ268 ET251 FO298 FJ679 FI358 FR33 GF594 PF689 GA241 GM220 GE995 DE49 GH233 GI350 GR30 GL299 GD1473 GP590 GU1671 GT502 GG44 GN224 GW245 GY592 HT509 HN504 HK852 HU36 IS354 IN91 ID62 IR98 IQ964 IE353 IM44 IL972 IT39 JM1876 JP81 JE44 JO962 KZ7 KE254 KI686 XK383 KW965 KG996 LA856 LV371 LB961 LS266 LR231 LY218 LI423 LT370 LU352 MO853 MG261 MW265 MY60 MV960 ML223 MT356 MH692 MQ596 MR222 MU230 YT262 MX52 FM691 MD373 MC377 MN976 ME382 MS1664 MA212 MZ258 MM95 NA264 NR674 NP977 NL31 NC687 NZ64 NI505 NE227 NG234 KP850 MK389 NO47 OM968 PK92 PW680 PS970 PA507 PG675 PY595 PE51 PH63 PL48 PT351 PR1787 QA974 RE262 RO40 RU7 RW250 KN1869 LC1758 VC1784 WS685 SM378 ST239 SA966 SN221 RS381 SC248 SL232 SG65 SX1721 SK421 SI386 SB677 SO252 ZA27 KR82 SS211 ES34 LK94 SD249 SR597 SE46 CH41 SY963 TW886 TJ992 TZ255 TH66 TL670 TG228 TO676 TT1868 TN216 TR90 TM993 TC1649 TV688 UG256 UA380 AE971 GB44 US1 UY598 UZ998 VU678 VA39 VE58 VN84 VI1340 YE967 ZM260 ZW263';
    const COUNTRIES = RAW.split(' ').map((t) => ({ iso: t.slice(0, 2), dial: t.slice(2) }));

    // Page language -> default country; plus the main patient markets shown first.
    const LOCALE_COUNTRY: Record<string, string> = { en:'GB', tr:'TR', ru:'RU', de:'DE', ar:'SA', az:'AZ', uk:'UA', bg:'BG', nl:'NL', fr:'FR', pl:'PL', ro:'RO', it:'IT', el:'GR', es:'ES', cs:'CZ', sk:'SK', hu:'HU', lt:'LT', lv:'LV', et:'EE', pt:'PT', sv:'SE', da:'DK', fi:'FI', hr:'HR', sl:'SI', sr:'RS', no:'NO' };
    const POPULAR = ['GB','IE','DE','NL','BE','FR','CH','AT','IT','ES','SE','NO','DK','PL','RO','BG','GR','UA','RU','AZ','TR','SA','AE','US'];
    // For shared dial codes, which country a typed "+code" should pick by default.
    const SHARED_DEFAULT: Record<string, string> = { '1':'US', '7':'RU', '44':'GB', '39':'IT', '262':'RE', '590':'GP', '599':'CW' };
    const PLACEHOLDER: Record<string, string> = { en:'Search country or code', tr:'Ülke veya kod ara', ru:'Страна или код', de:'Land oder Vorwahl suchen', ar:'ابحث عن الدولة أو الرمز', az:'Ölkə və ya kod axtar', uk:'Країна або код', bg:'Търсене на държава или код', nl:'Zoek land of code', fr:'Pays ou indicatif', pl:'Szukaj kraju lub kodu', ro:'Caută țara sau prefixul', it:'Cerca paese o prefisso', el:'Αναζήτηση χώρας ή κωδικού', es:'Buscar país o prefijo', cs:'Hledat zemi nebo předvolbu', sk:'Hľadať krajinu alebo predvoľbu', hu:'Ország vagy hívószám', lt:'Ieškoti šalies ar kodo', lv:'Meklēt valsti vai kodu', et:'Otsi riiki või koodi', pt:'Procurar país ou indicativo', sv:'Sök land eller riktnummer', da:'Søg land eller landekode', fi:'Hae maata tai suuntanumeroa', hr:'Traži državu ili pozivni broj', sl:'Poišči državo ali klicno kodo', sr:'Претрага државе или позивног броја', no:'Søk etter land eller landskode' };
    const EMPTY: Record<string, string> = { en:'No match', tr:'Sonuç yok', ru:'Ничего не найдено', de:'Kein Treffer' };

    const pageLocale = picker.getAttribute('data-locale') || document.documentElement.lang || 'en';
    const fold = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/ı/g, 'i');
    const flagOf = (iso: string) => iso.replace(/./g, (c) => String.fromCodePoint(127397 + c.charCodeAt(0)));

    // Country names in the page language, the visitor's browser language(s) and English — all searchable.
    const langs = Array.from(new Set([pageLocale, ...((navigator.languages as readonly string[]) || []), 'en']));
    const namers: Array<{ of(code: string): string | undefined }> = [];
    langs.forEach((l) => { try { namers.push(new (Intl as any).DisplayNames([l], { type: 'region' })); } catch (e) {} });
    const FALLBACK_NAME: Record<string, string> = { XK: 'Kosovo' };
    const rows = COUNTRIES.map((c) => {
      const names: string[] = [];
      namers.forEach((n) => { try { const v = n.of(c.iso); if (v && v !== c.iso) names.push(v); } catch (e) {} });
      if (!names.length) names.push(FALLBACK_NAME[c.iso] || c.iso);
      return { iso: c.iso, dial: c.dial, label: names[0], hay: fold(names.join(' ') + ' ' + c.iso + ' +' + c.dial + ' ' + c.dial) };
    });
    const byIso: Record<string, typeof rows[number]> = {};
    rows.forEach((r) => { byIso[r.iso] = r; });
    const collator = (() => { try { return new Intl.Collator(pageLocale); } catch (e) { return new Intl.Collator('en'); } })();
    const alpha = rows.slice().sort((a, b) => collator.compare(a.label, b.label));

    search.placeholder = PLACEHOLDER[pageLocale] || PLACEHOLDER.en;

    let current = byIso[LOCALE_COUNTRY[pageLocale] || 'GB'] || byIso.GB;
    // Prefer the region from the browser language when it matches the page language (e.g. en-IE -> Ireland).
    try {
      const nav = (navigator.language || '').split('-');
      if (nav[1] && nav[0].toLowerCase() === pageLocale && byIso[nav[1].toUpperCase()]) current = byIso[nav[1].toUpperCase()];
    } catch (e) {}

    function select(r: typeof rows[number], focusNumber: boolean){
      current = r;
      flagEl!.textContent = flagOf(r.iso);
      dialEl!.textContent = '+' + r.dial;
      codeInput!.value = '+' + r.dial;
      btn!.setAttribute('title', r.label);
      if (focusNumber) { close(); numInput?.focus(); }
    }

    let visible: Array<typeof rows[number]> = [];
    let active = -1;
    function render(){
      const q = fold(search!.value.trim());
      const qDigits = q.replace(/^\+/, '').replace(/\s/g, '');
      list!.innerHTML = '';
      if (q) {
        visible = alpha.filter((r) => r.hay.includes(q) || (/^\d+$/.test(qDigits) && r.dial.startsWith(qDigits)));
        // Exact dial-code matches first, then names that start with the query.
        visible.sort((a, b) => {
          const sa = (a.dial === qDigits ? 0 : 2) + (fold(a.label).startsWith(q) ? 0 : 1);
          const sb = (b.dial === qDigits ? 0 : 2) + (fold(b.label).startsWith(q) ? 0 : 1);
          return sa - sb || collator.compare(a.label, b.label);
        });
      } else {
        const top = [current.iso, ...POPULAR.filter((i) => i !== current.iso)].map((i) => byIso[i]).filter(Boolean);
        visible = top.concat(alpha.filter((r) => !top.includes(r)));
      }
      const frag = document.createDocumentFragment();
      const topCount = q ? 0 : POPULAR.length;
      visible.forEach((r, i) => {
        if (!q && i === topCount) { const sep = document.createElement('li'); sep.className = 'cc-sep'; sep.setAttribute('role', 'separator'); frag.appendChild(sep); }
        const li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.setAttribute('data-i', String(i));
        li.setAttribute('aria-selected', r.iso === current.iso ? 'true' : 'false');
        li.innerHTML = '<span class="cc-flag"></span><span class="cc-name"></span><span class="cc-code"></span>';
        (li.children[0] as HTMLElement).textContent = flagOf(r.iso);
        (li.children[1] as HTMLElement).textContent = r.label;
        (li.children[2] as HTMLElement).textContent = '+' + r.dial;
        frag.appendChild(li);
      });
      if (!visible.length) { const li = document.createElement('li'); li.className = 'cc-empty'; li.textContent = EMPTY[pageLocale] || EMPTY.en; frag.appendChild(li); }
      list!.appendChild(frag);
      setActive(q && visible.length ? 0 : -1);
    }
    function setActive(i: number){
      active = i;
      list!.querySelectorAll('li.cc-active').forEach((el) => el.classList.remove('cc-active'));
      if (i < 0) return;
      const el = list!.querySelector('li[data-i="' + i + '"]');
      if (el) { el.classList.add('cc-active'); (el as HTMLElement).scrollIntoView({ block: 'nearest' }); }
    }
    function open(){
      panel!.hidden = false;
      btn!.setAttribute('aria-expanded', 'true');
      search!.value = '';
      render();
      search!.focus();
    }
    function close(){
      panel!.hidden = true;
      btn!.setAttribute('aria-expanded', 'false');
    }

    btn.addEventListener('click', () => { if (panel.hidden) open(); else close(); });
    search.addEventListener('input', render);
    search.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(Math.min(active + 1, visible.length - 1)); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(Math.max(active - 1, 0)); }
      else if (e.key === 'Enter') { e.preventDefault(); const r = visible[active < 0 ? 0 : active]; if (r) select(r, true); }
      else if (e.key === 'Escape') { e.preventDefault(); close(); btn.focus(); }
    });
    list.addEventListener('mousedown', (e) => e.preventDefault());
    list.addEventListener('click', (e) => {
      const li = (e.target as Element).closest('li[data-i]');
      if (li) select(visible[Number(li.getAttribute('data-i'))], true);
    });
    document.addEventListener('click', (e) => { if (!panel.hidden && !picker.contains(e.target as Node)) close(); });

    // Typing or pasting a full international number (+49 151…, 0049 151…) picks the country automatically.
    numInput?.addEventListener('input', () => {
      const raw = numInput.value.trim();
      const m = raw.match(/^(?:\+|00)(\d{1,4})/);
      if (!m) return;
      const digits = m[1];
      let found: typeof rows[number] | null = null;
      for (let len = Math.min(4, digits.length); len >= 1 && !found; len--) {
        const d = digits.slice(0, len);
        if (current.dial === d) { found = current; break; }
        const iso = SHARED_DEFAULT[d] || (rows.find((r) => r.dial === d) || {} as any).iso;
        if (iso) found = byIso[iso];
      }
      if (!found) return;
      select(found, false);
      numInput.value = raw.replace(/^(?:\+|00)/, '').slice(found.dial.length).replace(/^[\s\-()]+/, '');
    });

    select(current, false);
  })();

  const leadForm = document.getElementById('leadForm') as HTMLFormElement | null;
  const phoneCode = document.getElementById('phoneCode') as HTMLInputElement | null;
  const phoneNumber = document.getElementById('phoneNumber') as HTMLInputElement | null;
  const phoneHidden = document.getElementById('phone') as HTMLInputElement | null;

  leadForm?.addEventListener('submit', function(e){
    e.preventDefault();
    if (phoneHidden) {
      const code = phoneCode?.value ?? '';
      const num = (phoneNumber?.value ?? '').trim();
      phoneHidden.value = num ? `${code} ${num}` : '';
    }
    try { (window as any).gtag?.('event', 'generate_lead', { form_name: 'free_plan', page_path: location.pathname }); } catch (_) {}
    const def = document.getElementById('formDefault');
    const success = document.getElementById('formSuccess');
    const formData = new FormData(leadForm);
    const body = new URLSearchParams(formData as unknown as Record<string, string>).toString();
    fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body,
    })
      .then(() => {
        if (def) (def as HTMLElement).style.display = 'none';
        success?.classList.add('show');
      })
      .catch(() => {
        // Network/submission failure: still show a confirmation rather than a dead
        // end, but this case should be rare — Netlify Forms endpoint is the same
        // origin as the page itself.
        if (def) (def as HTMLElement).style.display = 'none';
        success?.classList.add('show');
      });
  });

  function animateCount(el: Element){
    const target = parseFloat(el.getAttribute('data-count-to') || '0');
    const duration = 1200;
    let start: number | null = null;
    function easeOutCubic(x: number){ return 1 - Math.pow(1 - x, 3); }
    function step(ts: number){
      if (start === null) start = ts;
      const raw = Math.min((ts - start) / duration, 1);
      (el as HTMLElement).textContent = String(Math.floor(easeOutCubic(raw) * target));
      if (raw < 1) requestAnimationFrame(step);
      else (el as HTMLElement).textContent = String(target);
    }
    requestAnimationFrame(step);
  }
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const countEls = document.querySelectorAll('.count-num');
  // Show the real rating immediately — a count-up from 0 made the section read "0/5" at first glance.
  countEls.forEach((el) => { (el as HTMLElement).textContent = el.getAttribute('data-count-to'); });

  const reveals = document.querySelectorAll('.reveal');
  if (!reduceMotion && 'IntersectionObserver' in window) {
    const robs = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('is-visible'); robs.unobserve(en.target); } });
    }, { threshold: 0, rootMargin: '0px 0px 25% 0px' });
    reveals.forEach((el) => robs.observe(el));
  } else {
    reveals.forEach((el) => el.classList.add('is-visible'));
  }
</script>
</BaseLayout>
