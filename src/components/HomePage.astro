---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getHome, getTreatments, TREATMENT_CONTENT_LOCALES, localesForTreatment } from '../i18n/content';
import { getHomeSeo } from '../i18n/home-seo';
import { localePath } from '../i18n/locales';
import { treatmentSlug } from '../i18n/slugs';

export interface Props { locale: string; }
const { locale } = Astro.props;
const t = getHome(locale);
const seo = getHomeSeo(locale);
const pageTitle = seo?.title ?? `${t.hero_h1?.replace(/<[^>]+>/g,'') ?? 'Nizam Abdullayev Dental Clinic'} — Istanbul`;
const pageDescription = seo?.description ?? t.hero_lead ?? '';
const hasTreatmentPages = TREATMENT_CONTENT_LOCALES.includes(locale);
const treatments = getTreatments(locale);
const linkLocale = hasTreatmentPages ? locale : 'en';

const treatCards: Array<{ id: string; img: string; title: string; desc: string; warranty?: boolean }> = [
  { id: 'all-on-4-5-6', img: '/images/all-on-4.jpg', title: treatments['all-on-4-5-6']?.title ?? 'All-on-4/5/6', desc: treatments['all-on-4-5-6']?.tagline ?? '', warranty: true },
  { id: 'hollywood-smile', img: '/images/hollywood-smile.jpg', title: treatments['hollywood-smile']?.title ?? 'Hollywood Smile', desc: treatments['hollywood-smile']?.tagline ?? '' },
  { id: 'emax-veneers', img: '/images/emax-veneers-smile.jpg', title: treatments['emax-veneers']?.title ?? 'E-max Veneers', desc: treatments['emax-veneers']?.tagline ?? '' },
  { id: 'monolithic-zirconia', img: '/images/monolithic-zirconia.jpg', title: treatments['monolithic-zirconia']?.title ?? 'Monolithic Zirconia', desc: treatments['monolithic-zirconia']?.tagline ?? '', warranty: true },
  { id: 'dental-implants', img: '/images/dental-implants.jpg', title: treatments['dental-implants']?.title ?? 'Dental Implants', desc: treatments['dental-implants']?.tagline ?? '', warranty: true },
  { id: 'zygomatic-implants', img: '/images/zygomatic-implants.png', title: treatments['zygomatic-implants']?.title ?? 'Zygomatic Implants', desc: treatments['zygomatic-implants']?.tagline ?? '', warranty: true },
  { id: 'dental-bridge', img: '/images/dental-bridge.jpg', title: treatments['dental-bridge']?.title ?? 'Dental Bridge', desc: treatments['dental-bridge']?.tagline ?? '', warranty: true },
  { id: 'invisalign', img: '/images/invisalign.png', title: treatments['invisalign']?.title ?? 'Invisalign', desc: treatments['invisalign']?.tagline ?? '' },
  { id: 'digital-smile-design', img: '/images/digital-smile-design.jpg', title: treatments['digital-smile-design']?.title ?? 'Digital Smile Design', desc: treatments['digital-smile-design']?.tagline ?? '' },
  { id: 'teeth-whitening', img: '/images/teeth-whitening.jpg', title: treatments['teeth-whitening']?.title ?? 'Teeth Whitening', desc: treatments['teeth-whitening']?.tagline ?? '' },
  { id: 'screw-retained-occlusal', img: '/images/screw-retained.jpg', title: treatments['screw-retained-occlusal']?.title ?? 'Screw-Retained System', desc: treatments['screw-retained-occlusal']?.tagline ?? '' },
  { id: 'gingivectomy', img: '/images/gingivectomy.jpg', title: treatments['gingivectomy']?.title ?? 'Gingivectomy', desc: treatments['gingivectomy']?.tagline ?? '' },
  { id: 'sinus-lift', img: '/images/sinus-lift.jpg', title: treatments['sinus-lift']?.title ?? 'Sinus Lift', desc: treatments['sinus-lift']?.tagline ?? '' },
  { id: 'root-canal-therapy', img: '/images/root-canal.jpg', title: treatments['root-canal-therapy']?.title ?? 'Root Canal Therapy', desc: treatments['root-canal-therapy']?.tagline ?? '' },
  { id: 'full-denture', img: '/images/full-denture.webp', title: treatments['full-denture']?.title ?? 'Full Denture', desc: treatments['full-denture']?.tagline ?? '' },
  { id: 'orthodontics', img: '/images/orthodontics.jpg', title: treatments['orthodontics']?.title ?? 'Orthodontics & Braces', desc: treatments['orthodontics']?.tagline ?? '' },
];

function tp(id: string) {
  const idLocale = localesForTreatment(id).includes(locale) ? locale : 'en';
  return localePath(idLocale, treatmentSlug(idLocale, id as any) + '/');
}
---
<BaseLayout locale={locale} title={pageTitle} description={pageDescription} path="">
<!-- Review rating markup lives only here, on the page that actually displays the
     reviews section — not repeated across every treatment/blog page. -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Dentist",
  "@id": `https://dtnizamabdullayev.com/#clinic`,
  "aggregateRating": {"@type":"AggregateRating","ratingValue":"5","reviewCount":"88"}
})} />
<Header locale={locale} t={t} path="" showInstagram={true} />

<main>

  <!-- HERO -->
  <section class="hero-photo">
    <img class="hero-photo-bg" src="/images/clinic-room.jpg" alt="">
    <div class="hero-photo-overlay"></div>
    <div class="wrap hero-photo-inner">
      <span class="eyebrow eyebrow--light">{t.eyebrow}</span>
      <h1 class="hero-photo-h1" set:html={t.hero_h1}></h1>
      <p class="hero-photo-lead">{t.hero_lead}</p>
      <div class="cta-row">
        <a href={localePath(locale, '#plan')} class="btn btn-cyan">{t.cta_plan}</a>
        <a href="https://wa.me/905551901034?text=Hello%2C%20I%20would%20like%20a%20free%20consultation" target="_blank" rel="noopener" class="btn btn-outline-light">{t.cta_wa}</a>
      </div>
    </div>
  </section>

  <!-- HEALTHY SMILES -->
  {t.tooth_h2 && (
    <section class="brand-band">
      <div class="wrap tooth-block reveal">
        <div>
          <span class="eyebrow eyebrow--light">{t.tooth_eyebrow}</span>
          <h2 style="margin-top:14px;">{t.tooth_h2}</h2>
          <p>{t.tooth_desc}</p>
          <a href={localePath(locale, '#treatments')} class="btn btn-outline-light">{t.tooth_cta}</a>
        </div>
        <img src="/images/healthy-smiles.jpg" alt="Happy patient checking her smile" class="tooth-illustration tooth-photo" loading="lazy">
      </div>
    </section>
  )}

  <!-- DIGITAL WORKFLOW STANDALONE -->
  {t.digital_big_title && (
    <section style="padding-top:0;">
      <div class="wrap digital-static reveal">
        <div class="digital-static-photo"><img src="/images/itero-scanner.jpg" alt="iTero digital scanner" loading="lazy"></div>
        <div>
          <div class="fb-icon fb-icon--static"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h5"/></svg></div>
          <h3>{t.digital_big_title}</h3>
          <p>{t.digital_big_desc}</p>
        </div>
      </div>
    </section>
  )}

  <!-- TREATMENTS -->
  <section id="treatments" class="section--alt">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">{t.treat_eyebrow}</span>
        <h2 style="margin-top:14px;">{t.treat_h2}</h2>
      </div>
      <div class="photo-treat-grid reveal">
        {treatCards.map((c) => (
          <div class="pcard">
            <div class="photo-frame"><img class="photo" src={c.img} alt={c.title} loading="lazy"></div>
            <div class="body">
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
              {c.warranty && (
                <div class="warranty-tag">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l7 3v6c0 5-3 8.5-7 11-4-2.5-7-6-7-11V5z"/></svg>
                  <span>{t.warranty_tag}</span>
                </div>
              )}
              <a class="link" href={tp(c.id)}>
                <span class="badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg></span>
                <span>{t.learn_more}</span>
              </a>
            </div>
          </div>
        ))}
      </div>
      <p class="special-care">{t.special_care}</p>
    </div>
  </section>

  <!-- BEFORE / AFTER -->
  {t.gallery2_h2 && (
    <section class="section--alt">
      <div class="wrap">
        <div class="head reveal" style="margin:0 auto 32px;text-align:center;">
          <span class="eyebrow">{t.gallery2_eyebrow}</span>
          <h2 style="margin-top:14px;">{t.gallery2_h2}</h2>
        </div>
        <div class="reveal ba-gallery-grid">
          <img src="/images/before-after-1.jpg" alt="Before and after case 1" loading="lazy">
          <img src="/images/before-after-2.jpg" alt="Before and after case 2" loading="lazy">
        </div>
      </div>
    </section>
  )}

  <!-- ACCOMMODATION / TRANSFER / RESULT -->
  {t.accommodation_title && (
    <section class="brand-band" style="padding-top:56px;">
      <div class="wrap">
        <div class="feature-banner reveal">
          <div class="fcard">
            <div class="fcard-photo"><img src="/images/accommodation.jpg" alt="Partner hotel accommodation" loading="lazy"></div>
            <div class="fcard-body">
              <div class="fb-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21v-7a4 4 0 014-4h10a4 4 0 014 4v7M3 21h18M7 10V6a2 2 0 012-2h6a2 2 0 012 2v4"/></svg></div>
              <h3>{t.accommodation_title}</h3>
              <p>{t.accommodation_desc}</p>
            </div>
          </div>
          <div class="fcard">
            <div class="fcard-photo"><img src="/images/transfer.jpg" alt="Private transfer vehicle in Istanbul" loading="lazy"></div>
            <div class="fcard-body">
              <div class="fb-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 16l7-2 4-9 2 1-3 8 6-1 2 2-8 3-3 5-2-1 2-4z"/></svg></div>
              <h3>{t.transfer_big_title}</h3>
              <p>{t.transfer_big_desc}</p>
            </div>
          </div>
          <div class="fcard">
            <div class="fcard-photo"><img src="/images/result.jpg" alt="Happy patient after treatment" loading="lazy"></div>
            <div class="fcard-body">
              <div class="fb-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M8 13s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"/></svg></div>
              <h3>{t.result_title}</h3>
              <p>{t.result_desc}</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- OBJECTION STRIP -->
  <section style="padding-top:0;">
    <div class="wrap reveal">
      <div class="strip">
        <div class="strip-item">
          <div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M9 15l6-6M9.5 9.5h.01M14.5 14.5h.01"/></svg></div>
          <h3>{t.strip1_title}</h3><p>{t.strip1_desc}</p>
        </div>
        <div class="strip-item">
          <div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 3h6v3H9zM8.5 12l2 2 4-4"/></svg></div>
          <h3>{t.strip2_title}</h3><p>{t.strip2_desc}</p>
        </div>
        <div class="strip-item">
          <div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l7 3v6c0 5-3 8.5-7 11-4-2.5-7-6-7-11V5z"/><path d="M9 12l2 2 4-4"/></svg></div>
          <h3>{t.lifetime_title}</h3><p>{t.lifetime_desc}</p>
        </div>
        <div class="strip-item">
          <div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="3.2"/><path d="M5 20c0-3.3 3.1-6 7-6s7 2.7 7 6"/><path d="M18 4l1.3 1.3L22 3"/></svg></div>
          <h3>{t.routing_title}</h3><p>{t.routing_desc}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  {t.process_h2 && (
    <section class="section--alt">
      <div class="wrap">
        <div class="head reveal">
          <span class="eyebrow">{t.process_eyebrow}</span>
          <h2 style="margin-top:14px;">{t.process_h2}</h2>
        </div>
        <div class="process reveal">
          <div class="step">
            <div class="step-top"><div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4z"/></svg></div><span class="num">01</span></div>
            <h3>{t.step1_title}</h3><p>{t.step1_desc}</p>
          </div>
          <div class="step">
            <div class="step-top"><div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h5"/></svg></div><span class="num">02</span></div>
            <h3>{t.step2_title}</h3><p>{t.step2_desc}</p>
          </div>
          <div class="step">
            <div class="step-top"><div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 16l7-2 4-9 2 1-3 8 6-1 2 2-8 3-3 5-2-1 2-4z"/></svg></div><span class="num">03</span></div>
            <h3>{t.step3_title}</h3><p>{t.step3_desc}</p>
          </div>
          <div class="step">
            <div class="step-top"><div class="icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21v-7a4 4 0 014-4h10a4 4 0 014 4v7M3 21h18M7 10V6a2 2 0 012-2h6a2 2 0 012 2v4"/></svg></div><span class="num">04</span></div>
            <h3>{t.step4_title}</h3><p>{t.step4_desc}</p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ABOUT / DOCTOR -->
  {t.about_label && (
    <section class="section--alt" id="about">
      <div class="wrap about-split-grid reveal">
        <div class="about-split-photo">
          <img src="/images/doctor.jpg" alt="Dt. Nizam Abdullayev" loading="lazy">
          <div class="about-split-name">
            <h3>Dt. Nizam Abdullayev</h3>
            <span>{t.team_role}</span>
          </div>
        </div>
        <div>
          <span class="eyebrow">{t.about_label}</span>
          <h2 style="margin-top:14px;">{t.team_h2}</h2>
          <p>{t.about_p1}</p>
          <p>{t.about_p2}</p>
          <p>{t.about_p3}</p>
        </div>
      </div>
    </section>
  )}

  <!-- REVIEWS -->
  <section id="reviews">
    <div class="wrap reviews-layout reveal">
      <div>
        <span class="eyebrow">{t.reviews_eyebrow}</span>
        <h2 style="margin-top:14px;">{t.reviews_h2}</h2>
        <div class="review-platforms">
          <div class="platform-badge"><svg viewBox="0 0 48 48" width="20" height="20"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.5 6.5 29.6 4.5 24 4.5 13.5 4.5 5 13 5 23.5S13.5 42.5 24 42.5 43 34 43 23.5c0-1.3-.1-2.6-.4-3.8z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 13.5 24 13.5c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.5 7.5 29.6 5.5 24 5.5c-7.4 0-13.7 4.1-17 10.2z"/><path fill="#4CAF50" d="M24 43.5c5.5 0 10.4-1.9 14.2-5l-6.6-5.6c-2 1.5-4.6 2.4-7.6 2.4-5.2 0-9.6-3.4-11.2-8.1l-6.6 5.1C9.3 39 16 43.5 24 43.5z"/><path fill="#1976D2" d="M43.6 20.5H24v8h11.3c-.8 2.4-2.3 4.4-4.3 5.9l6.6 5.6C41.9 37 44 30.9 44 23.5c0-1.3-.1-2.6-.4-3.8z"/></svg> Google</div>
          <div class="platform-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M2 12h20M12 2a15 15 0 010 20 15 15 0 010-20z"/></svg> Infobel</div>
        </div>
        <div class="review-score"><span class="count-num" data-count-to="5">0</span> <span>/5</span></div>
        <p class="review-score-label">{t.review_score_label}</p>
        <p class="review-count"><span class="count-num" data-count-to="88">0</span> <span>{t.review_count_label}</span></p>
        <p style="font-size:12.5px;color:var(--ink-faint);margin:-10px 0 18px;">{t.review_count2}</p>
        <a href="https://wa.me/905551901034?text=Hello%2C%20I%20would%20like%20a%20free%20consultation" target="_blank" rel="noopener" class="btn btn-wa">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20zm4.4-5.9c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1s-.6.8-.8 1c-.1.1-.3.2-.5.1-.2-.1-1-.4-2-1.2-.7-.7-1.2-1.5-1.4-1.7-.1-.2 0-.4.1-.5l.4-.4.2-.4c.1-.1.1-.3 0-.4-.1-.1-.5-1.3-.7-1.8-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.8 2.3.9 2.5c.1.2 1.6 2.5 3.9 3.4.5.2 1 .4 1.3.5.5.2 1 .1 1.4.1.4-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1z"/></svg>
          <span>{t.cta_wa}</span>
        </a>
      </div>
      <div class="review-note-card" style="border-style:solid;">
        <div class="stars" style="color:var(--gold);letter-spacing:2px;font-size:16px;">★★★★★</div>
        <p style="font-size:15px;color:var(--ink);">{t.review1_quote}</p>
        <p style="display:flex;align-items:center;gap:7px;font-family:'DM Mono',monospace;font-size:13px;color:var(--ink-faint);margin:0;">
          <svg viewBox="0 0 48 48" width="15" height="15"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.5 6.5 29.6 4.5 24 4.5 13.5 4.5 5 13 5 23.5S13.5 42.5 24 42.5 43 34 43 23.5c0-1.3-.1-2.6-.4-3.8z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 13.5 24 13.5c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.5 7.5 29.6 5.5 24 5.5c-7.4 0-13.7 4.1-17 10.2z"/><path fill="#4CAF50" d="M24 43.5c5.5 0 10.4-1.9 14.2-5l-6.6-5.6c-2 1.5-4.6 2.4-7.6 2.4-5.2 0-9.6-3.4-11.2-8.1l-6.6 5.1C9.3 39 16 43.5 24 43.5z"/><path fill="#1976D2" d="M43.6 20.5H24v8h11.3c-.8 2.4-2.3 4.4-4.3 5.9l6.6 5.6C41.9 37 44 30.9 44 23.5c0-1.3-.1-2.6-.4-3.8z"/></svg>
          <span>{t.review1_author}</span>
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section--alt">
    <div class="wrap">
      <div class="head reveal" style="margin:0 auto 32px;text-align:center;">
        <span class="eyebrow">{t.faq_eyebrow}</span>
        <h2 style="margin-top:14px;">{t.faq_h2}</h2>
      </div>
      <div class="accordion reveal">
        {[1,2,3,4,5].map((n) => (
          <div class="acc-item">
            <button class="acc-trigger" type="button" aria-expanded="false">
              <span class="acc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M9 15l6-6M9.5 9.5h.01M14.5 14.5h.01"/></svg></span>
              <span class="acc-title">{t[`faq${n}_q`]}</span>
              <svg class="acc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="acc-panel"><p>{t[`faq${n}_a`]}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA + FORM -->
  <section id="plan" class="section--dark">
    <div class="wrap">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;" class="plan-cols">
        <div class="reveal">
          <span class="eyebrow" style="color:var(--gold-light);border-color:rgba(232,203,134,.3);background:rgba(232,203,134,.08);">{t.cta2_eyebrow}</span>
          <h2 style="margin-top:16px;">{t.cta2_h2}</h2>
          <p>{t.cta2_desc}</p>
          <div style="display:flex;flex-direction:column;gap:12px;align-items:flex-start;">
            <a href="https://wa.me/905551901034?text=Hello%2C%20I%20would%20like%20a%20free%20consultation" target="_blank" rel="noopener" class="btn btn-wa">
