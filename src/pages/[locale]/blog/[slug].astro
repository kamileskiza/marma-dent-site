---
import BlogPost from '../../../components/BlogPost.astro';
import { getBlogPosts, BLOG_LOCALES } from '../../../i18n/blog';
import { DEFAULT_LOCALE } from '../../../i18n/locales';

export function getStaticPaths() {
  const paths: Array<{ params: { locale: string; slug: string }; props: { post: any; postIndex: number } }> = [];
  for (const code of BLOG_LOCALES.filter((l) => l !== DEFAULT_LOCALE)) {
    getBlogPosts(code).forEach((post, postIndex) => {
      paths.push({ params: { locale: code, slug: post.slug }, props: { post, postIndex } });
    });
  }
  return paths;
}

const { locale, slug } = Astro.params;
const { post, postIndex } = Astro.props;
---
<BlogPost locale={locale as string} post={post} path={`blog/${slug}/`} postIndex={postIndex} />
